{
  "name": "tellann-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:app": "pnpm --filter dashboard build",
    "build:docs": "pnpm --filter @tellann/docs build",
    "build:marketing": "pnpm --filter @tellann/marketing build",
    "dev": "node scripts/dev.js",
    "dev:desktop-intent": "node scripts/run-desktop-intent-stack.mjs",
    "dev:app": "pnpm --filter dashboard dev",
    "dev:docs": "pnpm --filter @tellann/docs dev",
    "dev:marketing": "pnpm --filter @tellann/marketing dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @tellann/e2e-tests run test:e2e",
    "pack:sdks": "pnpm --dir packages/frontend-sdk pack --pack-destination ../../release/sdk && pnpm --dir packages/backend-sdk pack --pack-destination ../../release/sdk",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:publish": "pnpm --filter @tellann/frontend-sdk --filter @tellann/backend-sdk run build && changeset publish --no-git-checks",
    "billing:seed-plans": "pnpm --filter @tellann/db run seed:plans",
    "billing:sync-catalog": "node scripts/sync-billing-catalog.mjs",
    "billing:sync-catalog:dry-run": "node scripts/sync-billing-catalog.mjs --dry-run",
    "verify:billing": "tsx scripts/verify-billing-lifecycle.ts",
    "verify:settings": "tsx scripts/verify-settings-entitlements.ts",
    "verify:desktop:phase1": "node scripts/verify-desktop-phase1.mjs",
    "verify:desktop:phase2": "node scripts/verify-desktop-phase2.mjs",
    "verify:desktop:intent": "node scripts/verify-desktop-phase2.mjs",
    "verify:desktop:phase3": "node scripts/verify-desktop-phase3.mjs",
    "verify:desktop:packaged-phase3": "node scripts/verify-packaged-desktop-phase3.mjs",
    "verify:billing:lifecycle": "node scripts/verify-billing-lifecycle-features.mjs",
    "verify:billing:scope": "node scripts/verify-user-scoped-billing.mjs",
    "verify:billing:routing": "node scripts/verify-plan-change-routing.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/node": "^25.9.3",
    "ts-node": "^10.9.2",
    "turbo": "latest",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@9.0.0"
}
