{
  "name": "@sots/onboarding-api",
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/instrumentation-routes.test.js dist/sdk-setup-routes.test.js dist/desktop-routes.test.js dist/environment-policy.test.js",
    "dev": "node -r ../../scripts/register-root-env.cjs ../../node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@sots/authz": "workspace:*",
    "@sots/db": "workspace:*",
    "@sots/desktop-contracts": "workspace:*",
    "@sots/email": "workspace:*",
    "@sots/shared": "workspace:*",
    "@sots/storage": "workspace:*",
    "@sots/telemetry": "workspace:*",
    "@sots/rules": "workspace:*",
    "@sots/ai": "workspace:*",
    "@sots/entitlement-checker": "workspace:*",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
