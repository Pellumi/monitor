    "@tellann/desktop-contracts": "workspace:*",
    "@tellann/email": "workspace:*",
    "@tellann/entitlement-checker": "workspace:*",
    "@tellann/project-intelligence": "workspace:*",
    "@tellann/rules": "workspace:*",
    "@tellann/shared": "workspace:*",
    "@tellann/storage": "workspace:*",
    "@tellann/telemetry": "workspace:*",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
