{
  "name": "@tellann/db",
  "private": true,
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@tellann/shared": "workspace:*",
    "@tellann/rules": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "generate": "prisma generate",
    "push": "node -r ../../scripts/register-root-env.cjs ../../node_modules/prisma/build/index.js db push",
    "migrate:deploy": "node -r ../../scripts/register-root-env.cjs ../../node_modules/prisma/build/index.js migrate deploy",
    "migrate:dev": "node -r ../../scripts/register-root-env.cjs ../../node_modules/prisma/build/index.js migrate dev",
    "migrate:status": "node -r ../../scripts/register-root-env.cjs ../../node_modules/prisma/build/index.js migrate status",
    "seed:plans": "tsx -r ../../scripts/register-root-env.cjs src/seed-plans.ts",
    "seed:rulesets": "ts-node -r ../../scripts/register-root-env.cjs prisma/seeds/rulesets.ts",
    "seed:admin": "ts-node -r ../../scripts/register-root-env.cjs prisma/seeds/system-admin.ts",
    "test": "tsc && node --test dist/qa-flow-boundary.test.js"
  }
}
