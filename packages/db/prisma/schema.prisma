model OtpCode {
  id        String     @id @default(uuid())
  email     String
  codeHash  String // sha256(plaintext_code)
  purpose   OtpPurpose
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  createdAt DateTime   @default(now())

  @@index([email, purpose])
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique // sha256(plaintext_refresh_token)
  // The hash this session held immediately before its last rotation, kept so a
  // request that raced the rotation (a second tab, an in-flight retry) can still
  // be honoured for a few seconds instead of being logged out. Presenting it
  // after `rotatedAt` + grace is treated as token reuse and kills the session.
  previousRefreshTokenHash String? @unique
  rotatedAt        DateTime?
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model OrganizationMembership {
