datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id                   String    @id @default(uuid())
  name                 String
  slug                 String    @unique
  createdByUserId      String?
  createdAt            DateTime  @default(now())
  deletedAt            DateTime?
  deletionScheduledFor DateTime?
  deletionStatus       String    @default("ACTIVE")
  deletionLegalHold    Boolean   @default(false)

  // ─── Gap 4: Cross-tenant pattern matching ───────────────────────────────
  // Opted IN by default — org contributes anonymized state patterns to the
  // shared cross-tenant index. Org admins can disable this in settings.
  allowCrossTenantPatterns Boolean @default(true)

  // ─── Gap 5: MFA enforcement ─────────────────────────────────────────────
  // When true, OWNER/ADMIN members must have TOTP enabled to access the dashboard.
  mfaRequiredForAdmins Boolean @default(false)

  memberships              OrganizationMembership[]
  invitations              OrganizationInvitation[]
  applications             Application[]
  intentNormalizations     IntentNormalizationEntry[]
  subscription             Subscription?
  entitlement              Entitlement?
  notificationPreferences  NotificationPreference[]
  notificationEvents       NotificationEvent[]
  notifications            Notification[]
  oidcProvider             OIDCProvider?
  enterpriseSalesRequests  EnterpriseSalesRequest[]
  enterpriseAgreement      EnterpriseAgreement?
  storageLedgerEntries     StorageLedgerEntry[]
  programmaticAccessTokens ProgrammaticAccessToken[]
  trialHistory             SubscriptionTrialHistory[]
  settings                 OrganizationSettings?
  securitySettings         OrganizationSecuritySettings?
  projectWorkspaces        ProjectWorkspace[]
  qaRuns                   QARun[]
  sourceDocuments          SourceDocument[]
  deviceSessions           DeviceSession[]
  desktopSetupHandoffs     DesktopSetupHandoff[]
}

enum RulesetScope {
  GLOBAL
  ORGANIZATION
  APPLICATION
}

enum RulesetStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum RulesetVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum RulePatternType {
  DOMAIN_INFERENCE
  STATE_EXPECTATION
  TRANSITION_EXPECTATION
  MISSING_STATE
  MISSING_FLOW
  EDGE_CASE
  VALIDATION_CONSTRAINT
  RECOVERY_FLOW
}

enum RuleTriggerType {
  KEYWORD
  ROUTE_PATTERN
  API_PATTERN
  EVENT_TYPE
  STATE_NAME
  COMPONENT_NAME
  WORKFLOW_NAME
}

enum RuleSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum RuleSource {
  SYSTEM
  ADMIN
  USER_FEEDBACK
  AI_CANDIDATE
  OBSERVED_BEHAVIOR
}

enum AIFlowDraftSource {
  ONBOARDING_PROMPT
  FLOW_BUILDER
  ADMIN_TEST
  DOCUMENT
  REPOSITORY_SCAN
  HYBRID_ANALYSIS
  USER_CORRECTION
}

enum AIFlowDraftStatus {
  PENDING_REVIEW
  ACCEPTED
  PARTIALLY_ACCEPTED
  REJECTED
  EXPIRED
}

enum SuggestionType {
  PREREQUISITE
  IN_STATE_VALIDATION
  POST_REQUISITE
  ERROR_PATH
  EMPTY_STATE
  LOADING_STATE
  RECOVERY_PATH
  SECURITY_STATE
  BUSINESS_RULE
}

enum SuggestionSource {
  RULE_ENGINE
  AI
  HYBRID
}

enum RuleFeedbackType {
  ACCEPTED
  REJECTED
  EDITED
  DISMISSED
  PROMOTED
}

enum RuleCandidateSource {
  AI
  USER_FEEDBACK
  OBSERVED_FLOW_VARIATION
  ADMIN_CREATED
}

enum RuleCandidateStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  PROMOTED
  MERGED
}

enum AIFeature {
  FLOW_GENERATION
  FLOW_SUGGESTION
  DOMAIN_INFERENCE
  OUTPUT_REPAIR
}

enum AIInvocationStatus {
  SUCCESS
  FAILED
  VALIDATION_FAILED
  TIMEOUT
  RATE_LIMITED
  DEGRADED
  FALLBACK_USED
  BLOCKED_BY_POLICY
}

model Domain {
  id          String  @id @default(uuid())
  key         String  @unique
  name        String
  description String?
  isSystem    Boolean @default(true)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rulesets DomainRuleset[]
}

model DomainRuleset {
  id          String        @id @default(uuid())
  domainId    String
  key         String
  name        String
  description String?
  scope       RulesetScope  @default(GLOBAL)
  status      RulesetStatus @default(ACTIVE)
  priority    Int           @default(100)

  organizationId String?
  applicationId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domain   Domain                 @relation(fields: [domainId], references: [id])
  versions DomainRulesetVersion[]

  @@unique([domainId, key, organizationId, applicationId])
  @@index([domainId, status])
  @@index([organizationId])
  @@index([applicationId])
}

model DomainRulesetVersion {
  id        String               @id @default(uuid())
  rulesetId String
  version   Int
  status    RulesetVersionStatus @default(DRAFT)
  changelog String?
  metadata  Json?

  createdBy  String?
  promotedBy String?
  promotedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ruleset       DomainRuleset  @relation(fields: [rulesetId], references: [id])
  patterns      RulePattern[]
  flowTemplates FlowTemplate[]

  @@unique([rulesetId, version])
  @@index([rulesetId, status])
}

model RulePattern {
  id               String          @id @default(uuid())
  rulesetVersionId String
  key              String
  name             String
  description      String?
  patternType      RulePatternType
  severity         RuleSeverity    @default(INFO)
  matcherJson      Json
  outputJson       Json
  confidenceBase   Float           @default(0.7)
  source           RuleSource      @default(SYSTEM)
  isActive         Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rulesetVersion DomainRulesetVersion @relation(fields: [rulesetVersionId], references: [id])
  triggers       RuleTrigger[]

  @@index([rulesetVersionId, patternType])
  @@index([source])
}

model RuleTrigger {
  id            String          @id @default(uuid())
  rulePatternId String
  triggerType   RuleTriggerType
  value         String
  weight        Float           @default(1.0)
  createdAt     DateTime        @default(now())

  rulePattern RulePattern @relation(fields: [rulePatternId], references: [id])

  @@index([triggerType, value])
  @@index([rulePatternId])
}

model FlowTemplate {
  id                 String  @id @default(uuid())
  rulesetVersionId   String
  key                String
  name               String
  description        String?
  workflowType       String
  statesJson         Json
  transitionsJson    Json
  edgeCasesJson      Json
  requiredEventsJson Json?
  metadata           Json?
  confidenceBase     Float   @default(0.75)
  isActive           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rulesetVersion DomainRulesetVersion @relation(fields: [rulesetVersionId], references: [id])

  @@index([rulesetVersionId])
  @@index([workflowType])
}

model AIFlowDraft {
  id                     String            @id @default(uuid())
  organizationId         String
  applicationId          String
  environmentId          String?
  source                 AIFlowDraftSource
  status                 AIFlowDraftStatus @default(PENDING_REVIEW)
  /// Stores only the sanitized/redacted description — never raw user input
  productDescription     String?
  /// SHA-256 of the original raw description for audit deduplication (raw text never stored)
  productDescriptionHash String?
  inferredDomainKey      String?
  rulesetVersionIds      String[]          @default([])
  promptHash             String
  provider               String
  model                  String
  aiInvocationId         String?
  draftJson              Json
  validationJson         Json?
  confidence             Float             @default(0.0)
  createdBy              String?
  reviewedBy             String?
  reviewedAt             DateTime?
  rejectionReason        String?
  /// Approved document versions and repository snapshots used to derive this review draft.
  sourceManifest         Json?
  /// Immutable graph/version created only after explicit user acceptance.
  acceptedGraphId        String?
  acceptedGraphVersionId String?

  evidence IntentEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, applicationId])
  @@index([status])
  @@index([inferredDomainKey])
}

// =============================================================================
// AI FLOW DRAFT ASYNC JOB QUEUE (Gap 8 — non-blocking async generation)
// =============================================================================

enum AIFlowDraftJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model AIFlowDraftJob {
  id                 String               @id @default(uuid())
  organizationId     String
  applicationId      String
  environmentId      String?
  source             AIFlowDraftSource
  /// Already-sanitized description; raw text is never stored
  productDescription String
  domainKey          String
  rulesetVersionIds  String[]             @default([])
  sourceManifest     Json?
  status             AIFlowDraftJobStatus @default(QUEUED)
  /// Populated when status = COMPLETED
  draftId            String?
  errorMessage       String?
  attempts           Int                  @default(0)
  maxAttempts        Int                  @default(3)
  scheduledAt        DateTime             @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([status, scheduledAt])
  @@index([organizationId, applicationId])
}

model RuleFeedback {
  id             String           @id @default(uuid())
  organizationId String
  applicationId  String?
  rulePatternId  String?
  suggestionId   String?
  aiFlowDraftId  String?
  feedbackType   RuleFeedbackType
  beforeJson     Json?
  afterJson      Json?
  comment        String?
  createdBy      String?
  createdAt      DateTime         @default(now())

  @@index([organizationId, applicationId])
  @@index([rulePatternId])
  @@index([suggestionId])
  @@index([aiFlowDraftId])
}

model RuleCandidate {
  id                    String              @id @default(uuid())
  domainId              String?
  organizationId        String?
  applicationId         String?
  source                RuleCandidateSource
  status                RuleCandidateStatus @default(PENDING_REVIEW)
  candidateJson         Json
  evidenceJson          Json?
  confidence            Float               @default(0.0)
  promotedRulePatternId String?
  reviewedBy            String?
  reviewedAt            DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([domainId])
  @@index([status])
  @@index([source])
}

model AIInvocationLog {
  id                String             @id @default(uuid())
  organizationId    String
  applicationId     String?
  userId            String?
  feature           AIFeature
  provider          String
  model             String
  promptHash        String
  promptVersion     String?
  inputSummaryJson  Json?
  outputSummaryJson Json?
  status            AIInvocationStatus
  errorCode         String?
  errorMessage      String?
  errorMessageSafe  String?
  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  latencyMs         Int?
  costEstimate      Decimal?
  repaired          Boolean            @default(false)
  fallbackUsed      Boolean            @default(false)
  createdBy         String?
  createdAt         DateTime           @default(now())

  @@index([organizationId, applicationId])
  @@index([feature])
  @@index([provider, model])
  @@index([status])
}

// =============================================================================
// PRICING & ENTITLEMENTS (Phase 1.8A)
// =============================================================================

enum PlanType {
  FREE
  LOCAL // Nigeria-only
  SOLO
  TEAM
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum BillingCurrency {
  USD
  NGN
}

model Plan {
  id              String   @id @default(uuid())
  type            PlanType @unique
  name            String
  description     String?
  monthlyPriceUsd Int? // Price in cents (2900 = $29)
  monthlyPriceNgn Int? // Price in kobo (4200000 = ₦42,000)
  annualPriceUsd  Int? // Price in cents
  annualPriceNgn  Int? // Price in kobo
  isPublic        Boolean  @default(true)
  sortOrder       Int      @default(0)

  // Resource limits
  maxApplications       Int
  maxEnvironmentsPerApp Int  @default(1)
  maxApiKeys            Int  @default(1)
  maxUsers              Int
  maxStorageGb          Int
  retentionDays         Int
  maxDemoSessions       Int? // null = unlimited

  featureFlags         FeatureFlag[]
  subscriptions        Subscription[]
  pendingSubscriptions Subscription[] @relation("PendingSubscriptionPlan")
  lapsedSubscriptions  Subscription[] @relation("LapsedSubscriptionPlan")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeatureFlag {
  id      String  @id @default(uuid())
  planId  String
  plan    Plan    @relation(fields: [planId], references: [id])
  feature String // e.g. "SESSION_REPLAY", "API_ACCESS", "SSO"
  enabled Boolean @default(false)
  tier    String? // e.g. "BASIC", "ADVANCED", "ALL_FORMATS"

  createdAt DateTime @default(now())

  @@unique([planId, feature])
}

model Subscription {
  id              String             @id @default(uuid())
  organizationId  String             @unique
  organization    Organization       @relation(fields: [organizationId], references: [id])
  /// The user who pays for this subscription. Billing country, currency,
  /// provider routing, and provider customer handles all resolve from this
  /// user's UserBillingProfile. Null on Free entitlement records, which have
  /// no payer.
  payerUserId     String?
  payer           User?              @relation("SubscriptionPayer", fields: [payerUserId], references: [id], onDelete: SetNull)
  planId          String
  plan            Plan               @relation(fields: [planId], references: [id])
  status          SubscriptionStatus @default(ACTIVE)
  billingInterval BillingInterval    @default(MONTHLY)
  billingCurrency BillingCurrency    @default(USD)

  // Paystack references (Phase 1.8C)
  paystackCustomerCode     String?
  paystackSubscriptionCode String?

  // Canonical provider state. Legacy provider-specific fields remain populated
  // during migration so existing subscriptions can be reconciled safely.
  activeProvider            String?
  providerCustomerId        String?
  providerSubscriptionId    String?
  providerPlanCode          String?
  providerManagementToken   String?
  providerPeriodStart       DateTime?
  providerPeriodEnd         DateTime?
  providerNextChargeAt      DateTime?
  paymentMethodReference    String?
  paymentMethodBrand        String?
  paymentMethodLast4        String?
  paymentMethodExpMonth     String?
  paymentMethodExpYear      String?
  paymentMethodAuthorizedAt DateTime?
  cancelAtPeriodEnd         Boolean   @default(false)

  // Enterprise overrides (JSON: { maxApplications: 200, ... })
  enterpriseOverrides Json?

  /// Free 14-day trial (BSS §10). The payer authorizes a card up front but is
  /// not charged until trialEndsAt, at which point the renewal worker converts
  /// the trial into a paid period unless it was cancelled or changed first.
  trialStartedAt     DateTime?
  trialEndsAt        DateTime?
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime

  /// When the renewal worker should next attempt a charge. Tellann schedules
  /// its own recurring charges against the stored payment method rather than
  /// relying on processor-side subscriptions, so trials, proration, and grace
  /// periods behave identically on every processor.
  nextBillingAt        DateTime?
  lastBillingAttemptAt DateTime?
  billingFailureCount  Int       @default(0)

  /// Grace period (BSS §14). Set when a renewal charge fails; the payer keeps
  /// full plan access until it elapses, then the subscription is scaled down to
  /// Free rather than suspended outright.
  graceEndsAt          DateTime?
  /// The paid plan held before a grace-period expiry downgraded the payer to
  /// Free, so resubscribing can offer the plan they actually lost.
  lapsedFromPlanId     String?
  lapsedFrom           Plan?     @relation("LapsedSubscriptionPlan", fields: [lapsedFromPlanId], references: [id])
  lapsedAt             DateTime?

  // Free subscriptions are entitlement records, not renewable provider contracts.
  nonRenewing        Boolean   @default(false)
  cancelledAt        DateTime?
  suspendedAt        DateTime?
  pendingPlanId      String?
  pendingPlan        Plan?     @relation("PendingSubscriptionPlan", fields: [pendingPlanId], references: [id])
  pendingChangeAt    DateTime?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  usageRecords UsageRecord[]

  @@index([nextBillingAt, status])
  @@index([trialEndsAt, status])
  @@index([graceEndsAt, status])
}

model BillingProviderPlan {
  id               String          @id @default(uuid())
  planType         PlanType
  billingInterval  BillingInterval
  currency         BillingCurrency
  provider         String
  environment      String          @default("production")
  providerPlanCode String
  version          Int             @default(1)
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  retiredAt        DateTime?

  @@unique([planType, billingInterval, currency, provider, environment, version])
  @@index([planType, billingInterval, currency, provider, environment, active])
}

model SubscriptionChange {
  id                  String           @id @default(uuid())
  organizationId      String
  sourcePlanId        String?
  targetPlanId        String
  sourceInterval      BillingInterval?
  targetInterval      BillingInterval
  currency            BillingCurrency
  direction           String
  effectiveMode       String
  status              String           @default("PREVIEWED")
  previewedAt         DateTime         @default(now())
  previewExpiresAt    DateTime
  prorationAt         DateTime
  amountDue           Int              @default(0)
  creditAmount        Int              @default(0)
  nextCycleAmount     Int
  effectiveAt         DateTime?
  provider            String?
  providerOperationId String?
  providerReference   String?
  idempotencyKey      String           @unique
  processingError     String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([organizationId, status])
  @@index([effectiveAt, status])
}

model BillingDunningAttempt {
  id                 String          @id @default(uuid())
  organizationId     String
  invoiceId          String?
  provider           String
  providerReference  String?
  attemptNumber      Int
  scheduledAt        DateTime
  startedAt          DateTime?
  completedAt        DateTime?
  status             String          @default("SCHEDULED")
  amount             Int
  currency           BillingCurrency
  idempotencyKey     String          @unique
  processingError    String?
  customerNotifiedAt DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([organizationId, providerReference, attemptNumber])
  @@index([scheduledAt, status])
  @@index([organizationId, status])
}

model Entitlement {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Resolved entitlements (denormalized from plan + enterprise overrides)
  planType PlanType
  features Json // { sessionReplay: true, apiAccess: false, ... }
  limits   Json // { applications: 10, users: 10, storageGb: 100, ... }
  support  Json // { emailSupport: true, prioritySupport: false, ... }

  resolvedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Billing identity is user-scoped. The signed-in user is the payer of record:
/// their ISO billing country determines currency, plan eligibility (Local is
/// NG-only), and which payment provider is routed. Organizations remain the
/// entitlement boundary (applications, seats, storage) but no longer carry any
/// billing identity of their own.
model UserBillingProfile {
  id           String  @id @default(uuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  countryCode  String
  legalName    String?
  billingEmail String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  taxId        String?

  /// Provider customer handles follow the payer, not the organization, so a
  /// user who pays for several organizations reuses one provider customer.
  paystackCustomerCode String?
  flutterwaveCustomerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubscriptionTrialHistory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Payer who consumed the trial. BSS §10 forbids concurrent/repeat trials;
  /// with user-scoped billing the constraint follows the payer as well as the
  /// organization, so one user cannot re-trial across fresh organizations.
  userId         String?
  planType       PlanType
  startedAt      DateTime
  endedAt        DateTime
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

model StorageLedgerEntry {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  objectKey      String       @unique
  ownerType      String
  ownerId        String?
  category       String
  bytes          BigInt
  reservedBytes  BigInt       @default(0)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, deletedAt])
}

model ProgrammaticAccessToken {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUserId String
  tokenHash       String       @unique
  tokenPrefix     String
  label           String?
  scopes          String[]
  expiresAt       DateTime?
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime     @default(now())

  @@index([organizationId, revokedAt])
}

model EnterpriseSalesRequest {
  id                    String       @id @default(uuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requesterUserId       String
  currentPlan           PlanType
  requestedCapabilities String[]
  deploymentPreference  String?
  notes                 String?
  status                String       @default("REQUESTED")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([organizationId, status])
}

model EnterpriseAgreement {
  id                  String       @id @default(uuid())
  organizationId      String       @unique
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contractStart       DateTime?
  contractEnd         DateTime?
  annualCommitment    Boolean      @default(true)
  legalHold           Boolean      @default(false)
  dataResidencyRegion String?
  negotiatedLimits    Json?
  negotiatedSupport   Json?
  capabilities        Json
  approvedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

// =============================================================================
// USAGE TRACKING (Phase 1.8B)
// =============================================================================

enum UsageMetric {
  APPLICATIONS
  USERS
  STORAGE_GB
  EVENTS
  SESSIONS
  DEMONSTRATIONS
  REPLAYS
  REPORTS
  EXPORTS
  API_CALLS
}

model UsageRecord {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  organizationId String
  applicationId  String?
  environmentId  String?
  metric         UsageMetric
  value          Float
  limit          Float? // Plan limit (null = unlimited)
  periodStart    DateTime
  periodEnd      DateTime
  recordedAt     DateTime     @default(now())

  @@index([organizationId, metric, periodStart])
  @@index([organizationId, applicationId, environmentId, metric])
}

model UsageSnapshot {
  id             String      @id @default(uuid())
  organizationId String
  applicationId  String?
  environmentId  String?
  metric         UsageMetric
  value          Float
  snapshotDate   DateTime    @default(now())

  @@index([organizationId, snapshotDate])
  @@index([organizationId, applicationId, environmentId])
}

// =============================================================================
// BILLING (Phase 1.8C)
// =============================================================================

model Invoice {
  id                     String          @id @default(uuid())
  organizationId         String
  /// Payer of record at the time the invoice was raised. Retained even if the
  /// user later leaves the organization so billing history stays attributable.
  payerUserId            String?
  invoiceNumber          String          @unique
  planType               PlanType
  billingInterval        BillingInterval
  currency               BillingCurrency
  subtotal               Int // In smallest unit (cents/kobo)
  /// Tax charged, in the same minor units as subtotal.
  tax                    Int             @default(0)
  /// Rate in basis points (750 = 7.5%), so the printed rate is exact.
  taxRate                Int             @default(0)
  /// Human label for the tax line, e.g. "VAT".
  taxLabel               String?
  /// ISO country whose tax regime was applied.
  taxJurisdiction        String?
  total                  Int
  status                 String          @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  provider               String?
  providerReference      String?
  providerCustomerId     String?
  providerSubscriptionId String?
  paystackRef            String?
  periodStart            DateTime
  periodEnd              DateTime
  paidAt                 DateTime?
  /// Why this invoice exists — SUBSCRIPTION, RENEWAL, UPGRADE, TRIAL_CONVERSION.
  reason                 String          @default("SUBSCRIPTION")
  createdAt              DateTime        @default(now())
  paymentEvents          PaymentEvent[]

  @@unique([provider, providerReference])
  @@index([organizationId, createdAt])
  @@index([payerUserId, createdAt])
  @@index([provider, providerSubscriptionId])
}

model PaymentEvent {
  id                String    @id @default(uuid())
  organizationId    String
  provider          String // "PAYSTACK" | "FLUTTERWAVE" | "MOCK"
  eventType         String // "checkout.completed", "invoice.paid", etc.
  providerEventId   String?
  providerReference String?
  invoiceId         String?
  invoice           Invoice?  @relation(fields: [invoiceId], references: [id])
  payload           Json
  processingStatus  String    @default("PROCESSED")
  processingError   String?
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?

  @@unique([provider, providerEventId])
  @@index([organizationId, processedAt])
  @@index([invoiceId])
  @@index([provider, providerReference])
}

model ApiKey {
  id              String      @id @default(uuid())
  environmentId   String
  environment     Environment @relation(fields: [environmentId], references: [id])
  /// SHA-256 hex digest of the raw key — never store plaintext
  keyHash         String      @unique
  /// First 8 hex chars prefixed with "tellann_" for safe display (e.g. tellann_a1b2c3d4)
  keyPrefix       String
  label           String?
  createdAt       DateTime    @default(now())
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  expiresAt       DateTime? // Explicit expiry for rotation policies
  createdByUserId String? // Audit: which user generated this key
}

model Application {
  id             String        @id @default(uuid())
  name           String
  summary        String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  environments         Environment[]
  onboardingProgress   ApplicationOnboardingProgress?
  desktopSetupHandoffs DesktopSetupHandoff[]

  sessions           Session[]
  states             State[]
  transitions        Transition[]
  candidateStates    CandidateState[]
  missingStates      MissingState[]
  missingFlows       MissingFlow[]
  coverageSnapshots  CoverageSnapshot[]
  workflows          Workflow[]
  demonstrations     Demonstration[]
  profile            ApplicationProfile?
  repositoryBinding  ApplicationRepositoryBinding?
  projectWorkspaces  ProjectWorkspace[]
  qaRuns             QARun[]
  sourceDocuments    SourceDocument[]
  projectConnections ProjectConnection[]

  // FDRS relations (Section 22)
  behaviorGraphs         BehaviorGraph[]
  compiledRulesets       CompiledRuleset[]
  reconciliationReports  ReconciliationReport[]
  observedSnapshots      ObservedGraphSnapshot[]
  promotionDecisions     PromotionDecision[]
  recommendationEvidence RecommendationEvidence[]
  intentNormalizations   IntentNormalizationEntry[]
}

model ApplicationProfile {
  id            String      @id @default(uuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])
  profileType   String
  createdAt     DateTime    @default(now())
}

model Session {
  id            String            @id // matches sessionId
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id])
  environmentId String?
  environment   Environment?      @relation(fields: [environmentId], references: [id])
  tenantId      String
  qaRunId       String?
  qaRun         QARun?            @relation(fields: [qaRunId], references: [id], onDelete: SetNull)
  traceId       String?
  startTime     DateTime
  endTime       DateTime
  events        SessionEvent[]
  statistics    SessionStatistic?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([qaRunId])
}

model SessionEvent {
  id           String   @id @default(uuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id])
  eventType    String
  eventVersion String
  source       String
  timestamp    DateTime
  metadata     Json
  createdAt    DateTime @default(now())
}

model SessionStatistic {
  id         String  @id @default(uuid())
  sessionId  String  @unique
  session    Session @relation(fields: [sessionId], references: [id])
  eventCount Int
  errorCount Int
  durationMs Int
}

model State {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  name          String
  category      String?
  visitCount    Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  transitionsFrom Transition[]       @relation("FromState")
  transitionsTo   Transition[]       @relation("ToState")
  observations    StateObservation[]
}

model Transition {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  fromStateId   String
  fromState     State       @relation("FromState", fields: [fromStateId], references: [id])
  toStateId     String
  toState       State       @relation("ToState", fields: [toStateId], references: [id])
  action        String?
  frequency     Int         @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  observations TransitionObservation[]
}

model StateObservation {
  id        String   @id @default(uuid())
  stateId   String
  state     State    @relation(fields: [stateId], references: [id])
  sessionId String
  eventId   String
  timestamp DateTime
}

model TransitionObservation {
  id           String     @id @default(uuid())
  transitionId String
  transition   Transition @relation(fields: [transitionId], references: [id])
  sessionId    String
  fromEventId  String
  toEventId    String
  timestamp    DateTime
}

model CandidateState {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  stateName     String
  reason        String
  approved      Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

model MissingState {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  stateName     String
  sourceState   String
  ruleName      String
  severity      String?
  confidence    Float       @default(1.0)
  reason        String?
  detectedAt    DateTime    @default(now())
}

model CoverageSnapshot {
  id                 String       @id @default(uuid())
  applicationId      String
  application        Application  @relation(fields: [applicationId], references: [id])
  environmentId      String?
  environment        Environment? @relation(fields: [environmentId], references: [id])
  createdAt          DateTime     @default(now())
  observedStates     Int
  candidateStates    Int
  approvedStates     Int
  coveragePercent    Float
  transitionCoverage Float        @default(0)
  flowCoverage       Float        @default(0)
}

model MissingFlow {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  sourceFlow    Json
  suggestedFlow Json
  reason        String
  severity      String?
  confidence    Float       @default(1.0)
  createdAt     DateTime    @default(now())
}

model Workflow {
  id              String      @id @default(uuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id])
  name            String
  path            Json
  stateCount      Int
  transitionCount Int
  executionCount  Int         @default(1)
  createdAt       DateTime    @default(now())
}

model Demonstration {
  id            String       @id @default(uuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id])
  environmentId String?
  environment   Environment? @relation(fields: [environmentId], references: [id])
  sessionId     String
  reportId      String?
  startedAt     DateTime     @default(now())
  completedAt   DateTime?
}

// =============================================================================
// FDRS — Flow Declaration & Reconciliation System (Section 22)
// Refactored to Polymorphic Behavior Knowledge Graphs (Phase 1.75)
// =============================================================================

enum GraphType {
  DECLARED
  DEMONSTRATED
  PRODUCTION
}

enum GraphSourceType {
  USER_DECLARATION
  DEMONSTRATION_SESSION
  PRODUCTION_OBSERVATION
  SYSTEM_GENERATED
}

enum FlowStatus {
  DRAFT
  COMPLETE
}

enum FlowLifecycleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SUPERSEDED
}

enum FlowNodeRole {
  NORMAL
  INITIAL
  TERMINAL
}

enum FlowTerminalKind {
  SUCCESS
  FAILURE
  CANCELLATION
  ALTERNATE
}

enum FlowBindingStatus {
  PENDING_INITIALIZATION
  INITIALIZING
  ACTIVE
  STALE
  FAILED
  REQUIRES_REBASE
}

enum FlowScanKind {
  INITIALIZATION
  RESCAN
}

enum FlowScanStatus {
  CREATED
  SCANNING
  ANALYZING
  COMPLETED
  FAILED
}

enum FlowInitializationStatus {
  PROPOSED
  APPROVED
  APPLYING
  VALIDATING
  COMPLETED
  FAILED
  ROLLED_BACK
}

enum FlowInitializationMode {
  AUTOMATED
  MANUAL
}

enum FlowInitializationStage {
  SDK_REQUIRED
  SCANNING
  REVIEW_READY
  ROADMAP_READY
  AWAITING_APPROVAL
  APPLYING
  AWAITING_TELEMETRY
  COMPLETED
  FAILED
}

enum StateCategory {
  NAVIGATION
  UI
  BUSINESS
  ERROR
  SYSTEM
}

enum StateProvenance {
  USER_AUTHORED
  SUGGESTED_ACCEPTED
  DEMONSTRATION_PROMOTED
  TELEMETRY_OBSERVED
}

enum NormalizationScope {
  GLOBAL
  ORGANIZATION
  APPLICATION
}

enum GraphRelationshipType {
  DECLARES
  DERIVED_FROM
  PROMOTED_FROM
  BASELINE_OF
  COMPARED_TO
}

model BehaviorGraph {
  id                 String              @id @default(uuid())
  applicationId      String
  application        Application         @relation(fields: [applicationId], references: [id])
  environmentId      String?
  environment        Environment?        @relation(fields: [environmentId], references: [id])
  isActive           Boolean             @default(true) // Only one active version per app/env at a time
  name               String
  status             FlowStatus          @default(DRAFT)
  lifecycleStatus    FlowLifecycleStatus @default(DRAFT)
  version            Int                 @default(1)
  graphType          GraphType           @default(DECLARED)
  sourceType         GraphSourceType     @default(USER_DECLARATION)
  declaredById       String?
  workflowType       String              @default("CUSTOM")
  purpose            String?
  scopeStatement     String?
  exclusions         String[]            @default([])
  tags               String[]            @default([])
  publishedVersionId String?
  supersededByFlowId String?
  // Set to "PENDING_REVIEW" while an AI-generated draft (e.g. from an uploaded
  // document) is awaiting the author's accept/discard decision. Cleared on accept.
  aiDraftStatus      String?
  aiDraftSourceName  String?
  // Number of graph mutations (accepted suggestions, restores) applied since the
  // current `version` was opened for drafting. The published `version` stays
  // frozen while drafting; `draftSeq` is the in-progress counter. Reset to 0 when
  // a new revision is opened.
  draftSeq           Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  completedAt        DateTime?

  nodes           BehaviorGraphNode[]
  edges           BehaviorGraphEdge[]
  rulesets        CompiledRuleset[]
  reconciliations ReconciliationReport[]
  versions        BehaviorGraphVersion[]
  draftSnapshots  FlowDraftSnapshot[]
  projectBindings FlowProjectBinding[]
  scans           FlowScan[]
  drifts          FlowDrift[]
  initializations FlowInitialization[]
  qaRuns          QARun[]

  @@index([applicationId, environmentId, isActive])
}

model BehaviorGraphNode {
  id                String            @id @default(uuid())
  graphId           String
  graph             BehaviorGraph     @relation(fields: [graphId], references: [id])
  stateName         String
  role              FlowNodeRole      @default(NORMAL)
  terminalKind      FlowTerminalKind?
  behaviorKey       String? // Stable semantic identity
  category          StateCategory     @default(BUSINESS)
  provenance        StateProvenance   @default(USER_AUTHORED)
  declaredById      String?
  canonicalBehavior String?
  description       String?
  actor             String?
  system            String?
  componentRef      String?
  endpointRef       String?
  expectedInput     Json?
  expectedOutput    Json?
  evidenceIds       String[]          @default([])
  createdAt         DateTime          @default(now())

  suggestions DeclaredStateSuggestion[]
  edgesFrom   BehaviorGraphEdge[]       @relation("FromNode")
  edgesTo     BehaviorGraphEdge[]       @relation("ToNode")
}

model BehaviorGraphEdge {
  id             String            @id @default(uuid())
  graphId        String
  graph          BehaviorGraph     @relation(fields: [graphId], references: [id])
  fromNodeId     String
  fromNode       BehaviorGraphNode @relation("FromNode", fields: [fromNodeId], references: [id])
  toNodeId       String
  toNode         BehaviorGraphNode @relation("ToNode", fields: [toNodeId], references: [id])
  action         String?
  condition      String?
  actor          String?
  system         String?
  componentRef   String?
  endpointRef    String?
  expectedInput  Json?
  expectedOutput Json?
  provenance     StateProvenance   @default(USER_AUTHORED)
  evidenceIds    String[]          @default([])
  createdAt      DateTime          @default(now())
}

model DeclaredStateSuggestion {
  id                       String             @id @default(uuid())
  parentStateId            String?
  parentState              BehaviorGraphNode? @relation(fields: [parentStateId], references: [id])
  organizationId           String?
  applicationId            String?
  flowId                   String?
  suggestionType           SuggestionType?
  title                    String?
  description              String?
  suggestedStateName       String
  category                 String
  severity                 RuleSeverity       @default(INFO)
  sourceTier               String
  rationale                String
  suggestedStatesJson      Json?
  suggestedTransitionsJson Json?
  evidenceJson             Json?
  source                   SuggestionSource   @default(RULE_ENGINE)
  confidence               Float
  status                   String             @default("PENDING")
  patternId                String?
  rulesetVersionIds        String[]           @default([])
  rulePatternIds           String[]           @default([])
  aiInvocationId           String?
  graphVersion             Int?
  graphHash                String?
  dedupeKey                String?
  generationTrigger        String?
  reviewId                 String?
  acceptedBy               String?
  acceptedAt               DateTime?
  rejectedBy               String?
  rejectedAt               DateTime?
  createdAt                DateTime           @default(now())

  outcomes SuggestionOutcome[]

  @@unique([flowId, graphHash, dedupeKey])
  @@index([organizationId, applicationId])
  @@index([flowId])
  @@index([status])
  @@index([suggestionType])
  @@index([flowId, graphHash, status])
  @@index([flowId, reviewId])
}

model CompiledRuleset {
  id            String        @id @default(uuid())
  flowId        String // Map flowId to BehaviorGraph.id
  flow          BehaviorGraph @relation(fields: [flowId], references: [id])
  applicationId String
  application   Application   @relation(fields: [applicationId], references: [id])
  version       Int
  compiledAt    DateTime      @default(now())
  rules         Json
  ruleCount     Int

  @@unique([flowId, version])
}

model ReconciliationReport {
  id            String        @id @default(uuid())
  flowId        String // Map flowId to BehaviorGraph.id
  flow          BehaviorGraph @relation(fields: [flowId], references: [id])
  applicationId String
  application   Application   @relation(fields: [applicationId], references: [id])
  environmentId String?
  environment   Environment?  @relation(fields: [environmentId], references: [id])
  flowVersionId String?
  qaRunId       String?

  confirmedCount        Int
  trueGapCount          Int
  undeclaredCount       Int
  expectedCoverageScore Float
  trueGaps              Json
  undeclared            Json

  confirmedTransitions      Int   @default(0)
  trueGapTransitions        Int   @default(0)
  undeclaredTransitions     Int   @default(0)
  transitionCoverageScore   Float @default(0)
  trueGapTransitionsList    Json  @default("[]")
  undeclaredTransitionsList Json  @default("[]")

  generatedAt DateTime @default(now())

  @@index([flowId, flowVersionId, generatedAt])
  @@index([qaRunId])
}

model BehaviorGraphVersion {
  id                         String               @id @default(uuid())
  graphId                    String
  graph                      BehaviorGraph        @relation(fields: [graphId], references: [id])
  version                    Int
  snapshot                   Json
  lifecycleStatus            FlowLifecycleStatus  @default(PUBLISHED)
  diagramRendererVersion     String               @default("1.0")
  diagramProjectionMetadata  Json?
  publishedAt                DateTime             @default(now())
  publishedById              String?
  derivedFromVersionId       String?
  isBaseline                 Boolean              @default(false)
  expectedStateCount         Int?
  expectedTransitionCount    Int?
  expectedCoverage           Float?
  expectedTransitionCoverage Float?
  createdAt                  DateTime             @default(now())
  qaRuns                     QARun[]
  projectBindings            FlowProjectBinding[]
  scans                      FlowScan[]
  initializations            FlowInitialization[]
  drifts                     FlowDrift[]

  @@unique([graphId, version])
}

// Point-in-time snapshot of a draft graph, written after every mutation that
// bumps `BehaviorGraph.draftSeq` (accepted suggestion, restore, revision open).
// Lets the editor list draft history for the current version and roll back to
// any earlier point without touching published `BehaviorGraphVersion` rows.
model FlowDraftSnapshot {
  id              String        @id @default(uuid())
  graphId         String
  graph           BehaviorGraph @relation(fields: [graphId], references: [id])
  version         Int // frozen published version this draft belongs to
  draftSeq        Int // 0 = baseline when the revision opened, N = after Nth mutation
  label           String?
  snapshot        Json // { states: [...], transitions: [...] }
  stateCount      Int           @default(0)
  transitionCount Int           @default(0)
  createdAt       DateTime      @default(now())
  createdById     String?

  @@unique([graphId, version, draftSeq])
  @@index([graphId, version])
}

model GraphRelationship {
  id               String                @id @default(uuid())
  sourceGraphId    String
  targetGraphId    String
  relationshipType GraphRelationshipType
  createdAt        DateTime              @default(now())
}

model PatternLibraryEntry {
  id                 String  @id @default(uuid())
  patternId          String  @unique
  triggerCanonicals  String
  triggerCategory    String
  suggestedStateName String
  category           String
  confidence         Float
  rationale          String
  libraryVersion     String
  active             Boolean @default(true)

  outcomes            SuggestionOutcome[]
  patternObservations PatternObservation[]
}

model IntentNormalizationEntry {
  id             String             @id @default(uuid())
  rawName        String
  canonical      String
  scope          NormalizationScope @default(GLOBAL)
  applicationId  String?
  application    Application?       @relation(fields: [applicationId], references: [id])
  organizationId String?
  organization   Organization?      @relation(fields: [organizationId], references: [id])
  libraryVersion String

  @@unique([scope, rawName, applicationId, organizationId])
}

model SuggestionOutcome {
  id              String                  @id @default(uuid())
  suggestionId    String
  suggestion      DeclaredStateSuggestion @relation(fields: [suggestionId], references: [id])
  patternId       String
  pattern         PatternLibraryEntry     @relation(fields: [patternId], references: [patternId])
  applicationId   String
  outcome         String
  rejectionReason String?
  recordedAt      DateTime                @default(now())
}

model ObservedGraphSnapshot {
  id              String       @id @default(uuid())
  applicationId   String
  application     Application  @relation(fields: [applicationId], references: [id])
  environmentId   String?
  environment     Environment? @relation(fields: [environmentId], references: [id])
  snapshot        Json
  stateCount      Int
  transitionCount Int
  capturedAt      DateTime     @default(now())
}

model PromotionDecision {
  id            String      @id @default(uuid())
  stateName     String
  flowId        String
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  accepted      Boolean
  reason        String?
  decidedById   String?
  timestamp     DateTime    @default(now())
}

model PatternObservation {
  id             String              @id @default(uuid())
  patternId      String
  pattern        PatternLibraryEntry @relation(fields: [patternId], references: [patternId])
  applicationId  String
  sourceBehavior String
  targetBehavior String
  occurrences    Int                 @default(1)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([applicationId, patternId, sourceBehavior, targetBehavior])
}

model RecommendationEvidence {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  workflowId    String?
  evidenceType  String
  source        String
  confidence    Float
  payload       Json
  createdAt     DateTime    @default(now())
}

enum EnvironmentType {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

model Environment {
  id                  String          @id @default(uuid())
  applicationId       String
  application         Application     @relation(fields: [applicationId], references: [id])
  name                String // e.g. "Development", "Staging", "Production"
  type                EnvironmentType @default(DEVELOPMENT)
  baseUrl             String?
  telemetryGatewayUrl String?
  isDefault           Boolean         @default(false)
  sdkEnabled          Boolean         @default(true)

  apiKeys               ApiKey[]
  sessions              Session[]
  behaviorGraphs        BehaviorGraph[]
  coverageSnapshots     CoverageSnapshot[]
  observedSnapshots     ObservedGraphSnapshot[]
  demonstrations        Demonstration[]
  reconciliationReports ReconciliationReport[]
  qaRuns                QARun[]
  desktopSetupHandoffs  DesktopSetupHandoff[]
  projectConnections    ProjectConnection[]
  flowProjectBindings   FlowProjectBinding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([applicationId, name])
}

model ApplicationOnboardingProgress {
  id                       String      @id @default(uuid())
  applicationId            String      @unique
  application              Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  organizationCreated      Boolean     @default(true)
  applicationCreated       Boolean     @default(true)
  templateSelected         Boolean     @default(false)
  expectedFlowsDefined     Boolean     @default(false)
  connectionMethodSelected String?
  sdkTargetsConfigured     Boolean     @default(false)
  sessionObserved          Boolean     @default(false)
  installationTestPassed   Boolean     @default(false)
  sdkConnected             Boolean     @default(false)
  demonstrationCompleted   Boolean     @default(false)
  analysisGenerated        Boolean     @default(false)
  firstAnalysisReviewed    Boolean     @default(false)
  firstReportGenerated     Boolean     @default(false)
  valueRealized            Boolean     @default(false)
  valueRealizedReason      String?
  completedAt              DateTime?
}

model DesktopSetupHandoff {
  id                     String         @id @default(uuid())
  tokenHash              String         @unique
  userId                 String
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId         String
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId          String
  application            Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  environmentId          String
  environment            Environment    @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  requestedAction        String         @default("CONNECT_SDK")
  claimedDeviceSessionId String?
  claimedDeviceSession   DeviceSession? @relation(fields: [claimedDeviceSessionId], references: [id], onDelete: SetNull)
  expiresAt              DateTime
  claimedAt              DateTime?
  consumedAt             DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([userId, expiresAt])
  @@index([applicationId, environmentId])
  @@index([claimedDeviceSessionId])
}

enum DesktopPermissionType {
  BROWSER_ONLY
  READ_WORKSPACE
  PROPOSE_INSTRUMENTATION
  APPLY_TASK
  RUN_COMMANDS
  SENSITIVE_BROWSER_ACTIONS
  MANAGE_QA_BRANCH
}

enum BranchPolicyEnforcement {
  WARN
  BLOCK
}

enum WorkspaceTrustStatus {
  UNTRUSTED
  READ_ONLY
  TRUSTED
  REVOKED
}

enum InstrumentationPlanStatus {
  PROPOSED
  APPROVED
  APPLYING
  APPLIED
  VALIDATING
  COMPLETED
  VALIDATION_FAILED
  STALE
  REJECTED
  FAILED
  ROLLED_BACK
}

enum InstrumentationPurpose {
  BOOTSTRAP
  FLOW
}

enum PatchSetStatus {
  CHECKPOINTED
  APPLYING
  APPLIED
  VALIDATED
  VALIDATION_FAILED
  ROLLING_BACK
  ROLLED_BACK
  ROLLBACK_FAILED
}

enum InstrumentationCapabilityAction {
  APPLY
  ROLLBACK
}

enum QARunMode {
  GUIDED
  ASSISTED
  OBSERVATION_ONLY
}

enum QACaptureTrack {
  FRONTEND
  BACKEND
}

enum QARunStatus {
  CREATED
  ARMED
  WAITING_FOR_INITIAL
  RECORDING
  RUNNING
  PAUSED
  PROCESSING
  COMPLETED
  COMPLETED_INCOMPLETE
  FAILED
  CANCELLED
}

model ProjectConnection {
  id                          String           @id @default(uuid())
  organizationId              String
  applicationId               String
  application                 Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  workspaceId                 String
  workspace                   ProjectWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  environmentId               String
  environment                 Environment      @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  createdByUserId             String
  detectedStack               Json?
  sdkTargets                  Json?
  initializationEventVerified Boolean          @default(false)
  initializationEventAt       DateTime?
  connectedAt                 DateTime?
  lastVerifiedAt              DateTime?
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt

  @@unique([workspaceId, environmentId])
  @@index([organizationId, applicationId])
}

model FlowProjectBinding {
  id                String               @id @default(uuid())
  organizationId    String
  applicationId     String
  flowId            String
  flow              BehaviorGraph        @relation(fields: [flowId], references: [id], onDelete: Cascade)
  flowVersionId     String
  flowVersion       BehaviorGraphVersion @relation(fields: [flowVersionId], references: [id], onDelete: Restrict)
  workspaceId       String
  workspace         ProjectWorkspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  environmentId     String
  environment       Environment          @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  status            FlowBindingStatus    @default(PENDING_INITIALIZATION)
  currentScanId     String?
  currentPatchSetId String?
  initializedAt     DateTime?
  lastRescannedAt   DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  scans           FlowScan[]
  initializations FlowInitialization[]
  qaRuns          QARun[]

  @@unique([flowVersionId, workspaceId, environmentId])
  @@index([applicationId, flowId, status])
}

model FlowScan {
  id                   String               @id @default(uuid())
  organizationId       String
  applicationId        String
  flowId               String
  flow                 BehaviorGraph        @relation(fields: [flowId], references: [id], onDelete: Cascade)
  flowVersionId        String
  flowVersion          BehaviorGraphVersion @relation(fields: [flowVersionId], references: [id], onDelete: Restrict)
  bindingId            String
  binding              FlowProjectBinding   @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  repositorySnapshotId String
  repositorySnapshot   RepositorySnapshot   @relation(fields: [repositorySnapshotId], references: [id], onDelete: Restrict)
  parentScanId         String?
  parentScan           FlowScan?            @relation("FlowScanParent", fields: [parentScanId], references: [id], onDelete: SetNull)
  childScans           FlowScan[]           @relation("FlowScanParent")
  kind                 FlowScanKind
  status               FlowScanStatus       @default(CREATED)
  scannerVersion       String
  detectedRoutes       Json?
  detectedComponents   Json?
  detectedEndpoints    Json?
  conformanceFindings  Json?
  errorMessageSafe     String?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime             @default(now())

  initializations FlowInitialization[]
  previousDrifts  FlowDrift[]          @relation("FlowDriftPreviousScan")
  currentDrifts   FlowDrift[]          @relation("FlowDriftCurrentScan")
  qaRuns          QARun[]

  @@index([bindingId, createdAt])
  @@index([applicationId, flowId, status])
}

model FlowInitialization {
  id                    String                   @id @default(uuid())
  organizationId        String
  applicationId         String
  flowId                String
  flow                  BehaviorGraph            @relation(fields: [flowId], references: [id], onDelete: Cascade)
  flowVersionId         String
  flowVersion           BehaviorGraphVersion     @relation(fields: [flowVersionId], references: [id], onDelete: Restrict)
  bindingId             String
  binding               FlowProjectBinding       @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  scanId                String
  scan                  FlowScan                 @relation(fields: [scanId], references: [id], onDelete: Restrict)
  instrumentationPlanId String?
  patchSetId            String?
  status                FlowInitializationStatus @default(PROPOSED)
  mode                  FlowInitializationMode?
  stage                 FlowInitializationStage  @default(SCANNING)
  manifestVersion       String                   @default("1.0")
  manifest              Json?
  reportProvenance      Json?
  selectedTargetAdapters String[]                @default([])
  roadmapRevision       Int                      @default(1)
  manualRoadmap         Json?
  verification          Json?
  codeReviewReport      Json?
  validation            Json?
  failureReasonSafe     String?
  approvedByUserId      String?
  approvedAt            DateTime?
  completedAt           DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  qaRuns QARun[]

  @@unique([bindingId, flowVersionId])
  @@index([applicationId, flowId, status])
}

model FlowDrift {
  id                   String               @id @default(uuid())
  organizationId       String
  applicationId        String
  flowId               String
  flow                 BehaviorGraph        @relation(fields: [flowId], references: [id], onDelete: Cascade)
  flowVersionId        String
  flowVersion          BehaviorGraphVersion @relation(fields: [flowVersionId], references: [id], onDelete: Restrict)
  previousScanId       String
  previousScan         FlowScan             @relation("FlowDriftPreviousScan", fields: [previousScanId], references: [id], onDelete: Restrict)
  currentScanId        String
  currentScan          FlowScan             @relation("FlowDriftCurrentScan", fields: [currentScanId], references: [id], onDelete: Restrict)
  implementationDiff   Json
  previousConformance  Json
  currentConformance   Json
  remediationAlignment Json?
  regressions          Json?
  edgeCases            Json?
  expectedFlowImpact   Json?
  createdAt            DateTime             @default(now())

  qaRuns QARun[]

  @@unique([previousScanId, currentScanId])
  @@index([applicationId, flowId, createdAt])
}

enum QARunArtifactType {
  SCREENSHOT
  PLAYWRIGHT_TRACE
  ACCESSIBILITY_SNAPSHOT
  CONSOLE_LOG
  NETWORK_LOG
  RUN_MANIFEST
}

enum PrivacyClassification {
  PUBLIC
  INTERNAL
  SENSITIVE
  RESTRICTED
}

enum SourceDocumentStatus {
  UPLOADING
  READY
  PROCESSING
  PROCESSED
  FAILED
  REJECTED
}

model DeviceSession {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deviceIdentifier String
  deviceName       String
  platform         String
  appVersion       String
  publicKey        String?
  scopes           String[]
  refreshTokenHash String        @unique
  // See UserSession.previousRefreshTokenHash — same rotation grace, so a desktop
  // retry that races its own refresh does not wipe the stored credential.
  previousRefreshTokenHash String? @unique
  rotatedAt        DateTime?
  lastSeenAt       DateTime      @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime      @default(now())

  qaRuns                      QARun[]
  instrumentationCapabilities InstrumentationCapability[]
  desktopSetupHandoffs        DesktopSetupHandoff[]

  @@unique([userId, deviceIdentifier])
  @@index([userId, revokedAt])
  @@index([organizationId, revokedAt])
}

model DesktopAuthorizationRequest {
  id                String    @id @default(uuid())
  requestTokenHash  String    @unique
  codeChallenge     String
  challengeMethod   String    @default("S256")
  deviceIdentifier  String
  deviceName        String
  platform          String
  appVersion        String
  scopes            String[]
  userId            String?
  authorizationHash String?   @unique
  expiresAt         DateTime
  authorizedAt      DateTime?
  consumedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([expiresAt, consumedAt])
  @@index([userId, authorizedAt])
}

model ProjectWorkspace {
  id                    String               @id @default(uuid())
  organizationId        String
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId         String
  application           Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdByUserId       String
  opaqueLocalId         String
  repositoryFingerprint String
  repositoryOriginHash  String?
  repositoryCloneUrl    String?
  // Stable across commits (unlike repositoryFingerprint, which folds in the
  // revision). Used to match a teammate's checkout to the application binding
  // when the repository has no GitHub origin to hash.
  portableManifestIdentity String?
  detectedStack         Json?
  packageManager        String?
  trustStatus           WorkspaceTrustStatus @default(UNTRUSTED)
  lastScannedAt         DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  permissions          PermissionGrant[]
  snapshots            RepositorySnapshot[]
  qaRuns               QARun[]
  instrumentationPlans InstrumentationPlan[]
  patchSets            PatchSet[]
  projectConnections   ProjectConnection[]
  flowProjectBindings  FlowProjectBinding[]

  // A workspace is one person's checkout on one machine. Two members who attach
  // the same repository must never collide onto a single row.
  @@unique([applicationId, createdByUserId, opaqueLocalId])
  @@index([organizationId, applicationId])
  @@index([applicationId, createdByUserId])
  @@index([applicationId, repositoryOriginHash])
}

/// The one repository an application is bound to, plus the QA branch policy that
/// every member's local workspace is measured against. Org-owned: identical for
/// everyone, regardless of where they cloned it or what they named the folder.
model ApplicationRepositoryBinding {
  id                       String                   @id @default(uuid())
  applicationId            String                   @unique
  application              Application              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  repositoryOriginHash     String?
  repositoryCloneUrl       String?
  portableManifestIdentity String?
  qaBranchName             String                   @default("tellann/qa-review")
  qaBranchBase             String                   @default("main")
  enforcement              BranchPolicyEnforcement  @default(WARN)
  allowAgentCheckout       Boolean                  @default(false)
  boundByUserId            String?
  updatedByUserId          String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@index([repositoryOriginHash])
}

model PermissionGrant {
  id              String                @id @default(uuid())
  workspaceId     String
  workspace       ProjectWorkspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  grantedByUserId String
  permissionType  DesktopPermissionType
  fileScopes      String[]
  commandScopes   String[]
  purpose         String
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime              @default(now())

  @@index([workspaceId, permissionType, revokedAt])
}

model RepositorySnapshot {
  id                    String           @id @default(uuid())
  workspaceId           String
  workspace             ProjectWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  revision              String?
  branch                String?
  dirty                 Boolean
  repositoryFingerprint String
  frameworkSummary      Json
  routeSummary          Json
  endpointSummary       Json
  documentationSummary  Json
  manifestHashes        Json
  scannerVersion        String
  redactionSummary      Json
  upstreamBranch        String?
  aheadCount            Int?
  behindCount           Int?
  createdAt             DateTime         @default(now())

  qaRuns               QARun[]
  instrumentationPlans InstrumentationPlan[]
  flowScans            FlowScan[]

  @@index([workspaceId, createdAt])
}

model SourceDocument {
  id               String               @id @default(uuid())
  organizationId   String
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId    String
  application      Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploadedByUserId String
  logicalKey       String
  filename         String
  mimeType         String
  checksum         String
  objectKey        String?
  uploadMode       String
  status           SourceDocumentStatus @default(UPLOADING)
  parserVersion    String?
  errorMessageSafe String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  versions       SourceDocumentVersion[]
  evidence       IntentEvidence[]
  processingJobs DocumentProcessingJob[]

  @@unique([applicationId, logicalKey])
  @@index([applicationId, checksum])
  @@index([organizationId, applicationId, status])
}

enum DocumentProcessingJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model DocumentProcessingJob {
  id                String                      @id @default(uuid())
  organizationId    String
  applicationId     String
  documentId        String
  document          SourceDocument              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requestedByUserId String
  status            DocumentProcessingJobStatus @default(QUEUED)
  inputManifest     Json
  resultVersionId   String?
  errorMessageSafe  String?
  attempts          Int                         @default(0)
  maxAttempts       Int                         @default(3)
  scheduledAt       DateTime                    @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([status, scheduledAt])
  @@index([organizationId, applicationId])
  @@index([documentId, createdAt])
}

model SourceDocumentVersion {
  id               String         @id @default(uuid())
  documentId       String
  document         SourceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version          Int
  extractedSummary Json
  redactionSummary Json
  structureSummary Json?
  processorVersion String
  createdAt        DateTime       @default(now())

  evidence IntentEvidence[]

  @@unique([documentId, version])
}

model IntentEvidence {
  id                 String                 @id @default(uuid())
  applicationId      String
  evidenceType       String
  sourceDocumentId   String?
  sourceDocument     SourceDocument?        @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  documentVersionId  String?
  documentVersion    SourceDocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  aiFlowDraftId      String?
  aiFlowDraft        AIFlowDraft?           @relation(fields: [aiFlowDraftId], references: [id], onDelete: Cascade)
  repositoryPathHash String?
  sourceLabel        String
  excerpt            String?
  symbol             String?
  locator            String?
  confidence         Float
  metadata           Json?
  createdAt          DateTime               @default(now())

  @@index([applicationId, evidenceType])
  @@index([sourceDocumentId])
  @@index([aiFlowDraftId])
}

model InstrumentationPlan {
  id                    String                    @id @default(uuid())
  workspaceId           String
  workspace             ProjectWorkspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repositorySnapshotId  String
  repositorySnapshot    RepositorySnapshot        @relation(fields: [repositorySnapshotId], references: [id], onDelete: Restrict)
  createdByUserId       String
  environmentId         String?
  purpose               InstrumentationPurpose    @default(BOOTSTRAP)
  flowId                String?
  flowVersionId         String?
  deviceSessionId       String?
  taskKey               String
  contractVersion       String                    @default("1.0")
  manifestVersion       String                    @default("1.0")
  adapterId             String
  adapterVersion        String
  frameworkVersion      String?
  supportedVersionRange String?
  status                InstrumentationPlanStatus @default(PROPOSED)
  risk                  String
  approvedFileScopes    String[]
  approvedCommandIds    String[]                  @default([])
  approvalHash          String?
  baseRevision          String?
  repositoryFingerprint String?
  targetFileHashes      Json?
  evidenceJson          Json?
  commandManifest       Json?
  eventMappingManifest  Json?
  planJson              Json
  validationJson        Json?
  staleReasonSafe       String?
  rejectionReasonSafe   String?
  failureReasonSafe     String?
  approvedByUserId      String?
  approvedAt            DateTime?
  expiresAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  patchSets    PatchSet[]
  capabilities InstrumentationCapability[]

  @@unique([workspaceId, taskKey])
  @@index([workspaceId, status])
  @@index([environmentId, status])
  @@index([flowId, flowVersionId, status])
}

model InstrumentationCapability {
  id              String                          @id @default(uuid())
  jtiHash         String                          @unique
  planId          String
  plan            InstrumentationPlan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  patchSetId      String?
  patchSet        PatchSet?                       @relation(fields: [patchSetId], references: [id], onDelete: Cascade)
  deviceSessionId String
  deviceSession   DeviceSession                   @relation(fields: [deviceSessionId], references: [id], onDelete: Cascade)
  action          InstrumentationCapabilityAction
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime                        @default(now())

  @@index([planId, action, consumedAt])
  @@index([deviceSessionId, expiresAt])
}

model PatchSet {
  id                    String              @id @default(uuid())
  workspaceId           String
  workspace             ProjectWorkspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instrumentationPlanId String
  instrumentationPlan   InstrumentationPlan @relation(fields: [instrumentationPlanId], references: [id], onDelete: Cascade)
  baseRevision          String?
  checkpointId          String
  checkpointKind        String              @default("LOCAL")
  checkpointMetadata    Json?
  manifestVersion       String              @default("1.0")
  approvedScopeHash     String?
  diffHash              String
  changedFileHashes     Json
  status                PatchSetStatus      @default(CHECKPOINTED)
  commandResultsJson    Json?
  validationJson        Json?
  rollbackJson          Json?
  failureReasonSafe     String?
  appliedByUserId       String?
  rolledBackByUserId    String?
  appliedAt             DateTime?
  validatedAt           DateTime?
  rolledBackAt          DateTime?
  createdAt             DateTime            @default(now())

  qaRuns       QARun[]
  capabilities InstrumentationCapability[]

  @@index([workspaceId, status])
}

model QARun {
  id                     String                @id @default(uuid())
  organizationId         String
  organization           Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId          String
  application            Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  environmentId          String
  environment            Environment           @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  workspaceId            String?
  workspace              ProjectWorkspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  deviceSessionId        String?
  deviceSession          DeviceSession?        @relation(fields: [deviceSessionId], references: [id], onDelete: SetNull)
  repositorySnapshotId   String?
  repositorySnapshot     RepositorySnapshot?   @relation(fields: [repositorySnapshotId], references: [id], onDelete: SetNull)
  expectedGraphVersionId String?
  expectedGraphVersion   BehaviorGraphVersion? @relation(fields: [expectedGraphVersionId], references: [id], onDelete: SetNull)
  flowId                 String?
  flow                   BehaviorGraph?        @relation(fields: [flowId], references: [id], onDelete: SetNull)
  flowBindingId          String?
  flowBinding            FlowProjectBinding?   @relation(fields: [flowBindingId], references: [id], onDelete: SetNull)
  flowInitializationId   String?
  flowInitialization     FlowInitialization?   @relation(fields: [flowInitializationId], references: [id], onDelete: SetNull)
  flowScanId             String?
  flowScan               FlowScan?             @relation(fields: [flowScanId], references: [id], onDelete: SetNull)
  flowDriftId            String?
  flowDrift              FlowDrift?            @relation(fields: [flowDriftId], references: [id], onDelete: SetNull)
  patchSetId             String?
  patchSet               PatchSet?             @relation(fields: [patchSetId], references: [id], onDelete: SetNull)
  createdByUserId        String
  mode                   QARunMode
  captureTracks          QACaptureTrack[]      @default([FRONTEND])
  status                 QARunStatus           @default(CREATED)
  initialStateKey        String?
  terminalStateKeys      String[]              @default([])
  lastObservedStateKey   String?
  boundaryStartedAt      DateTime?
  boundaryCompletedAt    DateTime?
  completionReason       String?
  timeoutAt              DateTime?
  targetUrl              String
  browserMetadata        Json?
  artifactManifest       Json?
  reconciliationReportId String?
  reportId               String?
  failureReasonSafe      String?
  retryOfRunId           String?
  startedAt              DateTime?
  endedAt                DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  artifacts        QARunArtifact[]
  findings         BrowserFinding[]
  observedSessions Session[]
  progressEvents   QARunProgressEvent[]

  @@index([organizationId, applicationId, createdAt])
  @@index([environmentId, status])
  @@index([deviceSessionId])
  @@index([flowId, expectedGraphVersionId, createdAt])
  @@index([flowBindingId, status])
}

model QARunProgressEvent {
  id         String   @id @default(uuid())
  runId      String
  run        QARun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  eventType  String
  stateKey   String?
  accepted   Boolean  @default(true)
  reason     String?
  metadata   Json?
  occurredAt DateTime @default(now())

  @@index([runId, occurredAt])
  @@index([runId, accepted])
}

model QARunArtifact {
  id                    String                @id @default(uuid())
  runId                 String
  run                   QARun                 @relation(fields: [runId], references: [id], onDelete: Cascade)
  artifactType          QARunArtifactType
  privacyClassification PrivacyClassification
  objectKey             String?
  bytes                 BigInt
  checksum              String
  capturedAt            DateTime
  metadata              Json?
  createdAt             DateTime              @default(now())

  findings BrowserFindingEvidence[]

  @@unique([runId, checksum])
  @@index([runId, artifactType])
}

model BrowserFinding {
  id                String   @id @default(uuid())
  runId             String
  run               QARun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  category          String
  severity          String
  confidence        Float
  title             String
  description       String
  url               String?
  viewport          Json?
  reproductionSteps Json
  recommendation    String?
  relatedWorkflowId String?
  relatedStateName  String?
  createdAt         DateTime @default(now())

  evidence BrowserFindingEvidence[]

  @@index([runId, severity])
}

model BrowserFindingEvidence {
  findingId  String
  finding    BrowserFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  artifactId String
  artifact   QARunArtifact  @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@id([findingId, artifactId])
}

model ActivationEvent {
  id             String   @id @default(uuid())
  organizationId String
  applicationId  String?
  environmentId  String?
  eventName      String
  metadata       Json?
  occurredAt     DateTime @default(now())

  @@index([organizationId, eventName, occurredAt])
}

// =============================================================================
// IDENTITY (Phase 2A)
// =============================================================================

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum OtpPurpose {
  SIGNUP // New user — OTP sent before User exists
  LOGIN // Returning user OTP auth
  INVITE // Accept org invitation
  ACCOUNT_DELETION
  MFA // Second-factor code — deliberately distinct from LOGIN so a first-factor
  // code can never be replayed as the second factor.
}

enum AuditAction {
  // ─── Identity & Auth ─────────────────────────────
  USER_CREATED
  LOGIN_SUCCESS
  LOGIN_FAILED
  OTP_SENT
  OTP_VERIFIED
  OTP_FAILED
  SESSION_REFRESHED
  SESSION_REVOKED
  LOGOUT
  MEMBER_INVITED
  MEMBER_JOINED
  MEMBER_REMOVED
  ROLE_CHANGED
  MFA_ENABLED
  MFA_DISABLED
  MFA_VERIFIED
  MFA_CHALLENGE_FAILED
  MFA_BACKUP_CODE_USED
  SSO_LOGIN_SUCCESS
  SSO_PROVIDER_CONFIGURED
  SSO_PROVIDER_REMOVED
  PASSWORD_SET
  PASSWORD_CHANGED
  PREFERRED_AUTH_CHANGED

  // ─── Ruleset Governance ───────────────────────────
  RULESET_VERSION_CREATED
  RULESET_VERSION_PROMOTED
  RULESET_VERSION_ARCHIVED
  RULE_CANDIDATE_APPROVED
  RULE_CANDIDATE_REJECTED
  RULE_PATTERN_CREATED
  RULE_PATTERN_UPDATED

  // ─── AI & Flow ────────────────────────────────────
  AI_DRAFT_CREATED
  AI_DRAFT_ACCEPTED
  AI_DRAFT_PARTIALLY_ACCEPTED
  AI_DRAFT_REJECTED
  AI_SUGGESTION_ACCEPTED
  AI_SUGGESTION_REJECTED
  FLOW_CREATED
  FLOW_UPDATED
  FLOW_DELETED
  FLOW_COMPLETED
  INSTRUMENTATION_PLAN_CREATED
  INSTRUMENTATION_PLAN_APPROVED
  INSTRUMENTATION_PLAN_REJECTED
  INSTRUMENTATION_APPLIED
  INSTRUMENTATION_VALIDATED
  INSTRUMENTATION_ROLLED_BACK
  INSTRUMENTATION_FAILED

  // ─── API Keys ─────────────────────────────────────
  API_KEY_CREATED
  API_KEY_REVOKED
  API_KEY_ROTATED

  // ─── Environments ─────────────────────────────────
  ENVIRONMENT_CREATED
  ENVIRONMENT_UPDATED
  ENVIRONMENT_DELETED

  // ─── Billing ──────────────────────────────────────
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_CANCELLED
  SUBSCRIPTION_PAST_DUE
  PLAN_CHANGED
  INVOICE_PAID
  INVOICE_FAILED
  BILLING_PROFILE_UPDATED
  ENTERPRISE_SALES_REQUESTED
  RETENTION_DATA_DELETED
  PROGRAMMATIC_TOKEN_CREATED
  PROGRAMMATIC_TOKEN_REVOKED

  // ─── Reports & Exports ────────────────────────────
  REPORT_GENERATED
  REPORT_EXPORTED

  // ─── Feature Flags ────────────────────────────────
  ORG_FEATURE_FLAG_CHANGED

  // ─── Admin RBAC ───────────────────────────────────
  SYSTEM_ADMIN_GRANTED
  SYSTEM_ADMIN_REVOKED
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  displayName          String?
  avatarUrl            String?
  passwordHash         String?
  preferredAuthMode    String    @default("OTP")
  passwordUpdatedAt    DateTime?
  deletedAt            DateTime?
  deletionScheduledFor DateTime?
  deletionStatus       String    @default("ACTIVE")
  deletionLegalHold    Boolean   @default(false)

  // ─── Gap 5: TOTP / MFA ──────────────────────────────────────────────────
  // totpSecret is stored AES-256 encrypted using MFA_ENCRYPTION_KEY.
  totpEnabled     Boolean   @default(false)
  totpSecret      String? // AES-256-GCM encrypted — never store plaintext
  totpEnabledAt   DateTime?
  totpBackupCodes String[]  @default([]) // bcrypt-hashed 8-char backup codes
  /// Active second factor. Kept alongside totpEnabled so a single field answers
  /// "is MFA on, and which kind" without inspecting several columns.
  mfaMethod       MfaMethod @default(NONE)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions                UserSession[]
  memberships             OrganizationMembership[]
  auditLogs               AuditLog[]
  notificationPreferences NotificationPreference[]
  userNotifications       UserNotification[]
  pushSubscriptions       PushSubscription[]
  notificationDevices     NotificationDevice[]
  emailDeliveries         EmailDelivery[]
  digestPreference        NotificationDigestPreference?
  preferences             UserPreference?
  deviceSessions          DeviceSession[]
  desktopSetupHandoffs    DesktopSetupHandoff[]
  deletionRequests        AccountDeletionRequest[]
  billingProfile          UserBillingProfile?
  paidSubscriptions       Subscription[]               @relation("SubscriptionPayer")
}

model AccountDeletionRequest {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  status             String    @default("SCHEDULED")
  confirmationPhrase String
  organizationIds    String[]
  scheduledFor       DateTime
  requestedAt        DateTime  @default(now())
  purgeStartedAt     DateTime?
  purgeCompletedAt   DateTime?
  lastCheckpoint     String?
  processingError    String?
  requestedIpHash    String?
  requestedUserAgent String?

  @@index([status, scheduledFor])
  @@index([userId, requestedAt])
}

model UserPreference {
