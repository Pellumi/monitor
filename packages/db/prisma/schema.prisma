model OrganizationSecuritySettings {
  id                         String       @id @default(uuid())
  organizationId             String       @unique
  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requireMfa                 Boolean      @default(false)
  idleTimeoutMinutes         Int          @default(60)
  maximumSessionHours        Int          @default(168)
  allowedEmailDomains        String[]     @default([])
  blockPersonalEmailDomains  Boolean      @default(false)
  invitationExpiryDays       Int          @default(7)
  requireVerifiedEmail       Boolean      @default(true)
  revokeSessionsOnRoleChange Boolean      @default(true)
  version                    Int          @default(1)
