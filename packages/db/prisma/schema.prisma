// =============================================================================
// NOTIFICATIONS & EMAIL (MVP)
// =============================================================================

enum EmailCategory {
  SECURITY
  ACCOUNT
  ONBOARDING
  REPORTS
  ALERTS
  BILLING
  TEAM
  DIGEST
  PRODUCT_EDUCATION
  COMPLIANCE
}

enum NotificationFrequency {
  IMMEDIATE
  DAILY_DIGEST
  WEEKLY_DIGEST
  NEVER
}

enum NotificationEventStatus {
  CREATED
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum EmailDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  FAILED
  SKIPPED
  SUPPRESSED
}

enum EmailProvider {
  RESEND
  CONSOLE
}

model EmailTemplate {
  id                String        @id @default(uuid())
  key               String        @unique
  category          EmailCategory
  subject           String
  preheader         String
  htmlPath          String
  textPath          String
  requiredVariables String[]
  defaultFrom       String
  version           Int           @default(1)
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model NotificationPreference {
  id             String                @id @default(uuid())
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       EmailCategory
  emailEnabled   Boolean               @default(true)
  inAppEnabled   Boolean               @default(true)
  webhookEnabled Boolean               @default(false)
  /// Standards-based Web Push while no dashboard client is visible. Off by
  /// default: it needs an explicit browser permission grant first.
  webPushEnabled Boolean               @default(false)
  /// Native notifications from a running Tellann Desktop instance.
  desktopEnabled Boolean               @default(true)
  frequency      NotificationFrequency @default(IMMEDIATE)
  /// Push/desktop are suppressed below this severity; the in-app feed always
  /// receives the item regardless.
  minSeverity    NotificationSeverity  @default(LOW)
  quietHoursEnabled Boolean            @default(false)
  /// Minutes past local midnight. start > end means the window wraps midnight.
  quietHoursStart Int?
  quietHoursEnd   Int?
  /// When set, CRITICAL still pushes during quiet hours.
  criticalOverridesQuietHours Boolean  @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([userId, organizationId, category])
  @@index([organizationId, category])
}

model NotificationEvent {
  id             String                  @id @default(uuid())
  organizationId String?
  organization   Organization?           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId  String?
  eventType      String
  severity       String                  @default("INFO")
  payload        Json
  status         NotificationEventStatus @default(CREATED)
  createdAt      DateTime                @default(now())
  deliveries     EmailDelivery[]

  @@index([organizationId, eventType, createdAt])
  @@index([applicationId, eventType, createdAt])
}

model EmailDelivery {
  id                  String              @id @default(uuid())
  notificationEventId String?
  notificationEvent   NotificationEvent?  @relation(fields: [notificationEventId], references: [id], onDelete: SetNull)
  userId              String?
  user                User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  toEmail             String
  templateKey         String
  provider            EmailProvider       @default(RESEND)
  providerMessageId   String?
  idempotencyKey      String?             @unique
  status              EmailDeliveryStatus @default(QUEUED)
  error               String?
  sentAt              DateTime?
  deliveredAt         DateTime?
  openedAt            DateTime?
  clickedAt           DateTime?
  bouncedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([toEmail, createdAt])
  @@index([providerMessageId])
  @@index([notificationEventId])
}

model EmailSuppression {
  id        String         @id @default(uuid())
  email     String
  reason    String
  category  EmailCategory?
  createdAt DateTime       @default(now())

  @@unique([email, category])
  @@index([email])
}

// =============================================================================
// CENTRAL NOTIFICATION PIPELINE (Phase 1)
//
// One logical notification per business event, fanned out to per-recipient
// feed state and per-channel delivery attempts. Email becomes one adapter
// rather than the owner of the record. See docs/notification_implementation_plan.md.
// =============================================================================

/// INFO < LOW < MEDIUM < HIGH < CRITICAL. Ordinal comparison drives the
/// per-preference minimum-severity threshold and quiet-hour overrides.
enum NotificationSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationChannel {
  IN_APP
  WEB_PUSH
  DESKTOP
  EMAIL
  WEBHOOK
}

enum NotificationDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED
  SUPPRESSED
}

enum NotificationDevicePlatform {
  WINDOWS
  MACOS
  LINUX
}

/// One logical event, scoped to its organization and optional resource.
///
/// `dedupeKey` collapses repeated detections of the same condition; `groupKey`
/// aggregates related findings in the UI. Idempotency for producers is on
/// (sourceEventType, sourceEventId).
model Notification {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId  String?
  workflowId     String?
  reportId       String?
  runId          String?

  type     String
  category EmailCategory
  severity NotificationSeverity @default(INFO)

  title    String
  body     String
  deepLink String?

  sourceEventType String
  sourceEventId   String?

  dedupeKey String?
  groupKey  String?
  metadata  Json    @default("{}")

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  recipients UserNotification[]
  deliveries NotificationDelivery[]

  @@unique([sourceEventType, sourceEventId])
  @@unique([organizationId, dedupeKey])
  @@index([organizationId, createdAt])
  @@index([groupKey])
}

/// Per-recipient feed state. One row per user authorized to see a notification.
model UserNotification {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String

  deliveredToFeed Boolean   @default(true)
  readAt          DateTime?
  dismissedAt     DateTime?
  actionedAt      DateTime?
  expiresAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([notificationId, userId])
  @@index([userId, organizationId, createdAt])
  @@index([userId, organizationId, readAt])
  @@index([userId, organizationId, dismissedAt])
}

/// One recipient/channel delivery attempt with bounded retry bookkeeping.
model NotificationDelivery {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String?
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(QUEUED)
  attempts       Int          @default(0)
  providerId     String?
  /// Sanitized short code, never the provider's raw error text.
  failureCode    String?
  skippedReason  String?
  nextAttemptAt  DateTime?
  sentAt         DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([notificationId, userId, channel])
  @@index([status, nextAttemptAt])
}

/// A browser Web Push subscription. One per browser/device; independently
/// revocable. Key material is encrypted at rest when NOTIFICATIONS_ENCRYPTION_KEY
/// is set.
model PushSubscription {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  endpoint       String   @unique
  p256dh         String
  auth           String
  userAgent      String?
  deviceLabel    String?
  enabled        Boolean  @default(true)
  failureCount   Int      @default(0)
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, enabled])
}

/// A desktop (Electron) installation registered to receive native
/// notifications while it is running. Closed-process delivery is out of scope
/// for Phase 1.
model NotificationDevice {
  id             String                    @id @default(uuid())
  userId         String
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  installationId String                    @unique
  platform       NotificationDevicePlatform
  appVersion     String?
  label          String?
  enabled        Boolean                   @default(true)
  present        Boolean                   @default(false)
  lastSeenAt     DateTime                  @default(now())
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([userId, enabled])
}

// =============================================================================
// FEATURE FLAGS (Organization-level)
// =============================================================================

model OrganizationFeatureFlag {
  id             String   @id @default(uuid())
  organizationId String
  key            String
  enabled        Boolean  @default(false)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

// =============================================================================
// AI USAGE AGGREGATES (Phase 1 — Metrics Persistence)
// =============================================================================

model AIUsageDailyAggregate {
  id             String    @id @default(uuid())
  organizationId String? // null = platform-wide aggregate
  applicationId  String?
  date           DateTime // Truncated to UTC midnight (day boundary)
  feature        AIFeature
  provider       String
  model          String

  totalCalls    Int @default(0)
  successCalls  Int @default(0)
  failedCalls   Int @default(0)
  repairedCalls Int @default(0)
  fallbackCalls Int @default(0)
  timeoutCalls  Int @default(0)

  totalInputTokens  Int     @default(0)
  totalOutputTokens Int     @default(0)
  totalTokens       Int     @default(0)
  totalCostUsd      Decimal @default(0) @db.Decimal(14, 6)

  avgLatencyMs Int @default(0)
  p95LatencyMs Int @default(0)
  maxLatencyMs Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, feature, provider, model, organizationId, applicationId])
  @@index([date, feature])
  @@index([organizationId, date])
  @@index([provider, model, date])
}

// =============================================================================
// SYSTEM ADMIN (DB-backed RBAC — replaces SYSTEM_ADMIN_USER_IDS env var)
// =============================================================================

enum SystemAdminScope {
  FULL // All admin capabilities
  RULESETS_ONLY // Can only manage rulesets and rule candidates
  READ_ONLY // Can only read admin data (audit logs, AI usage)
}

model SystemAdmin {
  id        String           @id @default(uuid())
  userId    String           @unique
  scope     SystemAdminScope @default(FULL)
  grantedBy String? // userId of granter (null = seeded)
  grantedAt DateTime         @default(now())
  revokedAt DateTime? // null = still active
  notes     String? // Reason for grant

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([revokedAt])
}

// =============================================================================
// GAP 4 — CROSS-TENANT PATTERN INDEX
// Anonymized, aggregated state patterns contributed by opted-in organizations.
// =============================================================================

model CrossTenantPatternIndex {
  id                String   @id @default(cuid())
  patternKey        String // canonical state name, e.g. "CHECKOUT_FAILURE"
  domain            String // "ecommerce", "lms", "generic"
  /// Anonymized example — contains only { stateName, category, transitionCount }
  /// Never stores organizationId or applicationId.
  anonymizedExample Json
  occurrenceCount   Int      @default(1)
  /// 0.0–1.0: computed as min(occurrenceCount / 50, 1.0)
  confidenceScore   Float
  /// Array of { suggestedStateName, category, rationale } branch-state suggestions
  suggestedBranches Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([patternKey, domain])
  @@index([domain])
  @@index([confidenceScore])
}

// =============================================================================
// GAP 5 — MFA CHALLENGE TOKEN
// Short-lived (5 min) challenge issued after first-factor verification when
// the user has TOTP enabled. Replaced by full session tokens on /auth/mfa/verify.
// =============================================================================

/// Which second factor a user has active. TOTP is an authenticator app;
/// EMAIL_OTP dispatches a code to the registered address at sign-in.
enum MfaMethod {
  NONE
  TOTP
  EMAIL_OTP
}

model MfaChallengeToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique // sha256(raw_challenge_token)
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// =============================================================================
// GAP 6 — SSO / OIDC PROVIDER
// One OIDC provider config per organization. The clientSecret field is
// AES-256-GCM encrypted using OIDC_CLIENT_SECRET_KEY env var.
// =============================================================================

model OIDCProvider {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  displayName    String // Shown on the login button, e.g. "Acme Corp SSO"
  issuerUrl      String // OIDC discovery base, e.g. https://login.microsoftonline.com/{tenant}/v2.0
  clientId       String
  /// AES-256-GCM encrypted client secret — never store plaintext
  clientSecret   String
  scopes         String[] @default(["openid", "email", "profile"])
  isActive       Boolean  @default(true)
  /// Email domains that must use this SSO provider, e.g. ["acme.com", "acme.co.uk"]
  allowedDomains String[] @default([])

  /// Optional: preset name for UI hints. One of: "microsoft", "okta", "google", "custom"
  providerPreset String? @default("custom")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([allowedDomains])
}

// =============================================================================
// GAP 7 — NOTIFICATION DIGEST PREFERENCES
// Per-user digest configuration for batch email workers.
// A separate model from NotificationPreference (which is per org/category).
// =============================================================================

enum DigestFrequency {
  DAILY
  WEEKLY
  NEVER
}

model NotificationDigestPreference {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  weeklyReport        Boolean @default(true)
  coverageAlerts      Boolean @default(true)
  // Only relevant for SystemAdmin users
  ruleCandidateAlerts Boolean @default(false)

  digestFrequency     DigestFrequency @default(WEEKLY)
  lastWeeklyReportAt  DateTime?
  lastCoverageAlertAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Why someone reached out through the public contact form. Mirrors the routes
/// offered on the marketing site so submissions arrive already triaged.
enum ContactSubmissionType {
  SALES
  ENTERPRISE
  SUPPORT
  PARTNERSHIP
  PRESS
  SECURITY
  PRIVACY
  GENERAL
}

enum ContactSubmissionStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

/// A message from the public contact form.
///
/// The fields every route asks for are columns so they can be filtered and
/// sorted; the route-specific ones (team size, requirement, impact, and so on)
/// vary per type and are kept in `details` rather than as a wide sparse table.
model ContactSubmission {
  id           String                  @id @default(uuid())
  type         ContactSubmissionType
  status       ContactSubmissionStatus @default(NEW)
  firstName    String
  lastName     String
  email        String
  organization String?
  subject      String?
  message      String
  /// Answers to the fields this contact type asks for, keyed by field name.
  details      Json                    @default("{}")
  /// Hashed, not stored raw: enough to spot a flood from one source without
  /// keeping an identifier for someone who has only sent us a question.
  ipHash       String?
  userAgent    String?
  /// Whether the notification email to the team was accepted for delivery.
  notifiedAt   DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([type, status])
  @@index([createdAt])
  @@index([email])
}
