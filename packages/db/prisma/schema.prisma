  organization                Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  primaryTimezone             String       @default("UTC")
  defaultApplicationId        String?
  defaultEnvironmentId        String?
  defaultReportFormat         String       @default("JSON")
  defaultGraphVisibility      String       @default("STANDARD")
  defaultDemonstrationMode    String       @default("GUIDED")
  defaultMemberRole           MemberRole   @default(MEMBER)
  defaultInvitationExpiryDays Int          @default(7)
  /// @deprecated Nothing reads this. Its vocabulary (INFO/WARNING/ERROR/CRITICAL)
  /// never matched RuleSeverity (CRITICAL/HIGH/MEDIUM/LOW/INFO), so it could not
  /// have filtered findings even if something had. Removed from the settings UI
