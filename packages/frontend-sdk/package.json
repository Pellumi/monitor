{
  "name": "@tellann/frontend-sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Tellann browser telemetry and QA-run correlation SDK",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pellumi/monitor.git",
    "directory": "packages/frontend-sdk"
  },
  "homepage": "https://github.com/Pellumi/monitor/tree/main/packages/frontend-sdk#readme",
  "bugs": {
    "url": "https://github.com/Pellumi/monitor/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "tsc && node --test dist/index.test.js",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/uuid": "^9.0.8",
    "typescript": "^5.0.0"
  }
}
