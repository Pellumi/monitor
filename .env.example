# ── Notifications: browser Web Push (VAPID) ──────────────────────────────────
# Generate a key pair once with `npx web-push generate-vapid-keys`. Without both
# keys the notification pipeline still runs (in-app + email + desktop); only
# standards-based browser push is disabled, exactly like RESEND_API_KEY above.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact URI the push services can reach you at. mailto: or https:.
VAPID_SUBJECT="mailto:alerts@tellann.co"
# Optional shared secret gating POST /internal/notifications between services.
NOTIFICATIONS_INTERNAL_SECRET=""

NPM_TOKEN=""
NGROK_AUTHTOKEN=""

# Application-aware capability rollout (docs/app/conditional-feature-visibility.md).
# CAPABILITIES_UI switches the dashboard sidebar/cards/overview to the resolved
# navigation; CAPABILITIES_ENFORCE makes report-engine, endpoint-engine,
# coverage-engine and demonstration-api reject requests the resolver disallows.
# Both false means every surface behaves exactly as it did before this system.
CAPABILITIES_UI="true"
CAPABILITIES_ENFORCE="true"
# Comma-separated capability keys to force UNAVAILABLE regardless of anything else.
CAPABILITIES_DISABLED=""

TELLANN_OCR_ENABLED=true
TELLANN_OCR_BASE_URL=
TELLANN_OCR_MODAL_KEY=
TELLANN_OCR_MODAL_SECRET=

# Production cookie scoping for the authenticated app subdomain.
# Leave empty for localhost development.
AUTH_COOKIE_DOMAIN=""

# Background workers admin (Bull Board job monitoring UI)
NEXT_PUBLIC_WORKERS_URL="http://localhost:3020"

# Shared secrets for service-to-service calls into the report and endpoint
# engines, which verify their caller. Unset locally: outside production those
# services treat an unauthenticated call as internal so the dev stack works.
REPORT_ENGINE_INTERNAL_SECRET=""
ENDPOINT_ENGINE_INTERNAL_SECRET=""

# AES-256 key encrypting uploaded source archives before they reach storage.
# Required in any deployment that accepts source uploads. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, archives are stored unencrypted and reported as such.
CODEBASE_ARCHIVE_ENCRYPTION_KEY=""

