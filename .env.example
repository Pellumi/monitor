DATABASE_URL="postgresql://tellann:password@localhost:5433/tellann?connection_limit=3"

KAFKA_BROKERS="localhost:9092"

CLICKHOUSE_HOST="http://localhost:8123"
CLICKHOUSE_DATABASE="tellann"
CLICKHOUSE_USER="tellann"
CLICKHOUSE_PASSWORD="password"

JWT_SECRET="replace-with-a-secure-random-secret"
NODE_ENV="development"

# Email delivery. Without RESEND_API_KEY the email package records a skipped
# delivery and logs the rendered message for local development.
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
EMAIL_SEND_DISABLED="false"
EMAIL_FROM_HELLO="Tellann <hello@tellann.co>"
EMAIL_FROM_SECURITY="Tellann Security <security@tellann.co>"
EMAIL_FROM_REPORTS="Tellann Reports <reports@tellann.co>"
EMAIL_FROM_ALERTS="Tellann Alerts <alerts@tellann.co>"
EMAIL_FROM_BILLING="Tellann Billing <billing@tellann.co>"
EMAIL_FROM_SUPPORT="Tellann Support <support@tellann.co>"

# Where public contact-form submissions are announced. Submissions are stored
# either way; without this the built-in default address is used.
CONTACT_NOTIFICATION_EMAIL="tellann.technologies@gmail.com"
# Submissions accepted from one IP per window before further ones are refused.
CONTACT_RATE_LIMIT_MAX="5"
CONTACT_RATE_LIMIT_WINDOW_MS="900000"

# ── Notifications: browser Web Push (VAPID) ──────────────────────────────────
# Generate a key pair once with `npx web-push generate-vapid-keys`. Without both
# keys the notification pipeline still runs (in-app + email + desktop); only
# standards-based browser push is disabled, exactly like RESEND_API_KEY above.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact URI the push services can reach you at. mailto: or https:.
VAPID_SUBJECT="mailto:alerts@tellann.co"
# Optional shared secret gating POST /internal/notifications between services.
NOTIFICATIONS_INTERNAL_SECRET=""

# Experimental flow intelligence / AI-assisted declaration
# Keep these disabled for public/local MVP flows unless you are explicitly
# testing AI draft generation or contextual suggestions.
AI_FEATURES_ENABLED="false"
AI_FLOW_GENERATION_ENABLED="false"
AI_FLOW_SUGGESTIONS_ENABLED="false"
AI_FLOW_SUGGESTIONS_TIMEOUT_MS="45000"

# Local/dev bypass for organization-level experimental AI entitlement checks.
# Keep false in shared, staging, and production environments.
AI_ALLOW_WITHOUT_ORG_ENTITLEMENT="false"

# Provider selection. "mock" uses deterministic local rule-based output and
# does not call an external provider. Set to "gemini" or "deepseek" with keys.
AI_PROVIDER="mock"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_API_URL="https://generativelanguage.googleapis.com/v1beta/openai/chat/completions"

DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_API_URL="https://api.deepseek.com/chat/completions"

# AI privacy/logging policy defaults. Raw prompts/output should stay disabled
# unless you are debugging locally with sanitized input.
AI_LOG_PROMPTS="false"
AI_STORE_RAW_OUTPUT="false"
AI_REDACT_INPUTS="true"

# Public web boundary
NEXT_PUBLIC_SITE_URL="http://localhost:3020"
NEXT_PUBLIC_MARKETING_URL="http://localhost:3020"
NEXT_PUBLIC_APP_URL="http://localhost:3010"
NEXT_PUBLIC_DOCS_URL="http://localhost:3021"
NEXT_PUBLIC_API_GATEWAY_URL="http://localhost:3000"
# Trust the forwarded-for chain when deriving the client IP for rate limiting.
# Leave empty behind no proxy: trusting the header where nothing strips it lets
# a caller forge the rate-limit key. "true", a hop count, or a proxy list.
API_GATEWAY_TRUST_PROXY=""
# How long a just-rotated refresh token stays usable, so a request that raced
# the rotation is not signed out. Milliseconds.
AUTH_REFRESH_GRACE_MS="30000"
API_GATEWAY_INTERNAL_URL="http://localhost:3000"
REPORT_ENGINE_URL="http://localhost:3004"
COVERAGE_ENGINE_URL="http://localhost:3003"
FDRS_API_URL="http://localhost:3008"

# API gateway traffic budgets. Browser dashboard traffic is intentionally
# higher because a single page can make several internal API requests.
API_GATEWAY_API_RATE_LIMIT_MAX="100"
API_GATEWAY_DESKTOP_RATE_LIMIT_MAX="10000"
API_GATEWAY_DASHBOARD_RATE_LIMIT_MAX="10000"
API_GATEWAY_RATE_LIMIT_WINDOW="15 minutes"

# Production cookie scoping for the authenticated app subdomain.
# Leave empty for localhost development.
AUTH_COOKIE_DOMAIN=""

# CORS/origin hints for deployed services.
APP_ORIGIN="https://app.domain-name.com"
MARKETING_ORIGIN="https://domain-name.com"
DOCS_ORIGIN="https://docs.domain-name.com"
CORS_ALLOWED_ORIGINS="https://app.domain-name.com"

# Service ports
API_GATEWAY_PORT="3000"
EVENT_COLLECTOR_PORT="3001"
GRAPH_ENGINE_PORT="3002"
COVERAGE_ENGINE_PORT="3003"
REPORT_ENGINE_PORT="3004"
DEMONSTRATION_API_PORT="3005"
ONBOARDING_API_PORT="3006"
ENDPOINT_ENGINE_PORT="3007"
FDRS_API_PORT="3008"
BILLING_API_PORT="3009"
USAGE_TRACKER_PORT="3012"
AUTH_API_PORT="3013"

# Background workers admin (Bull Board job monitoring UI)
NEXT_PUBLIC_WORKERS_URL="http://localhost:3020"

# Billing provider placeholders for MVP wiring.
# The billing API supports MOCK checkout/webhooks without these values.
# Stripe was fully retired on 2026-08-31. USD settles through Flutterwave.
PAYSTACK_SECRET_KEY=""
# Paystack signs webhooks with PAYSTACK_SECRET_KEY; no separate webhook secret is used.
PAYSTACK_SUCCESS_URL="https://app.tellann.co/settings/billing?success=1"
BILLING_PRIMARY_PROVIDER="FLUTTERWAVE"
# Enable only after the live Paystack USD certification checklist passes.
BILLING_PAYSTACK_USD_ENABLED="false"
BILLING_CATALOG_ENV="production"
# Real local checkout uses test credentials and test provider-plan catalog rows.
BILLING_ALLOW_TEST_PROVIDER_OVERRIDE="false"
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_SECRET_HASH=""
FLUTTERWAVE_SUCCESS_URL="http://localhost:3010/settings/billing?success=1"
FLUTTERWAVE_CANCEL_URL="http://localhost:3010/settings/billing?cancelled=1"
# Example: FLUTTERWAVE_PLAN_CODE_SOLO_MONTHLY_USD="12345"
# A high-entropy secret used to encrypt reusable Paystack authorization references.
BILLING_ENCRYPTION_KEY=""

# Shared secret letting background-workers drive the recurring billing cycle
# (trial conversions, renewals, grace-period expiry) on billing-api. Renewals do
# not run until this is set on BOTH services.
BILLING_INTERNAL_SECRET=""

# Free trial length, and how long a payer keeps access after a failed renewal
# before being scaled down to the Free plan.
BILLING_TRIAL_DAYS="14"
BILLING_GRACE_PERIOD_DAYS="7"

# INCLUSIVE means published prices already contain tax and the invoice breaks it
# out; EXCLUSIVE adds tax on top, which changes what customers pay and needs
# pricing sign-off (PPS §14).
BILLING_TAX_MODE="INCLUSIVE"

# Kafka / ClickHouse feature flags.
# Set KAFKA_ENABLED=false to keep writing events directly to Postgres (dev default).
# Set CLICKHOUSE_ENABLED=false to keep analytics queries running against Postgres.
KAFKA_ENABLED="false"
CLICKHOUSE_ENABLED="false"

# System admin bootstrap.
# Set to the email address of the first system admin. The auth service will
# automatically grant DB-backed SystemAdmin on first login if not already present.
# This replaces the old SYSTEM_ADMIN_USER_IDS approach.
SYSTEM_ADMIN_BOOTSTRAP_EMAIL=""

# ─── Gap 1: Redis (optional — falls back to in-memory cache if not set) ───────
# Set this in staging/production for distributed ruleset caching across
# multiple service instances. Leave blank for local single-process development.
REDIS_URL=""

# ─── Gap 5: MFA — TOTP Secret Encryption ────────────────────────────────────
# AES-256 key used to encrypt TOTP secrets at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes). Required when MFA is enabled.
MFA_ENCRYPTION_KEY=""

# ─── Gap 6: SSO / OIDC ────────────────────────────────────────────────────────
# AES-256 key used to encrypt OIDC client secrets stored in the database.
# Generate the same way as MFA_ENCRYPTION_KEY above.
OIDC_CLIENT_SECRET_KEY=""
# Base URL used when constructing OIDC redirect URIs (callback URLs).
# Must match the registered redirect URI in your IdP application.
OIDC_REDIRECT_BASE_URL="http://localhost:3013"

# ─── Gap 8: Observability ─────────────────────────────────────────────────────
# Public HTTPS API gateway injected into generated SDK configuration.
# Local development may use http://localhost:3000; deployed environments should use HTTPS.
TELLANN_PUBLIC_GATEWAY_URL="http://localhost:3000"

# Port for the /metrics endpoint on the background-workers service.
BACKGROUND_WORKERS_METRICS_PORT="3022"

# ─── OpenTelemetry Distributed Tracing ────────────────────────────────────────
# Set OTEL_TRACES_ENABLED=true to activate distributed tracing (requires Jaeger/Tempo).
OTEL_TRACES_ENABLED="false"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# OTEL_SERVICE_NAME is auto-detected from service name; override if needed.
