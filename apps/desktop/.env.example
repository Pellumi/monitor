# Tellann Desktop cloud endpoints. Do not add a trailing slash.
#
# Desktop talks to exactly ONE endpoint: the API gateway. It proxies the desktop
# auth routes (/auth/desktop/*) through to the privately-networked auth-api and
# fans out to every other service internally, so TELLANN_AUTH_URL matches
# TELLANN_API_URL unless auth-api is exposed on its own public hostname.
#
# For local development against `pnpm dev`, use http://127.0.0.1:3000 etc.
# For the deployed stack, use the Railway URLs, e.g.:
#   TELLANN_API_URL=https://tellann-api-gateway.up.railway.app
#   TELLANN_DASHBOARD_URL=https://tellann-dashboard.up.railway.app
TELLANN_API_URL=https://api.example.com
TELLANN_AUTH_URL=https://api.example.com

# Public dashboard opened for profile and billing links.
TELLANN_DASHBOARD_URL=https://app.example.com
VITE_TELLANN_DASHBOARD_URL=https://app.example.com

# Optional desktop runtime settings.
TELLANN_BROWSER_HEADLESS=false
TELLANN_UPDATE_URL=
TELLANN_UPDATE_CHANNEL=latest

# Optional override: point the main process at a different env file.
# TELLANN_DESKTOP_ENV_PATH=C:\\path\\to\\desktop.env
#
# Packaged builds: environment.ts also reads `.env` / `.env.production` from the
# install directory and from resources/ (electron-builder extraResources ships
# .env.production). Committed defaults live in .env.production.
