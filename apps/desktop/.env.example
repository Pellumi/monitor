# Tellann Desktop cloud endpoints. Do not add a trailing slash.
# The API gateway normally serves both application API and desktop auth routes,
# so TELLANN_AUTH_URL can usually match TELLANN_API_URL.
TELLANN_API_URL=https://api.example.com
TELLANN_AUTH_URL=https://api.example.com

# Public dashboard opened for profile and billing links.
TELLANN_DASHBOARD_URL=https://app.example.com
VITE_TELLANN_DASHBOARD_URL=https://app.example.com

# Optional desktop runtime settings.
TELLANN_BROWSER_HEADLESS=false
TELLANN_UPDATE_URL=
TELLANN_UPDATE_CHANNEL=latest

# Optional override: point the main process at a different env file.
# TELLANN_DESKTOP_ENV_PATH=C:\\path\\to\\desktop.env
