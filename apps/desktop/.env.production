# Endpoints baked into packaged / production Desktop builds.
#
# Two consumers read this file:
#   1. Vite, during `vite build` (mode=production) -> inlines VITE_* vars into the
#      renderer bundle.
#   2. The main process at runtime, via environment.ts, which also looks for this
#      file next to the installed executable and under resources/ (shipped by
#      electron-builder `extraResources`).
#
# The API gateway is the only endpoint Desktop calls directly; it proxies the
# private auth-api and all other Railway services internally. No trailing slash.
TELLANN_API_URL=https://tellann-api-gateway.up.railway.app
TELLANN_AUTH_URL=https://tellann-api-gateway.up.railway.app

TELLANN_DASHBOARD_URL=https://tellann-dashboard.up.railway.app
VITE_TELLANN_DASHBOARD_URL=https://tellann-dashboard.up.railway.app

TELLANN_BROWSER_HEADLESS=false
TELLANN_UPDATE_URL=
TELLANN_UPDATE_CHANNEL=latest
