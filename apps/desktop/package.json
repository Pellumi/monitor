{
  "name": "@sots/desktop",
  "version": "0.1.0",
  "description": "Tellann desktop agent for guided browser QA, expected-flow inference, and bounded instrumentation.",
  "author": "Tellann",
  "private": true,
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.main.json --watch\" \"wait-on http-get://127.0.0.1:5174/src/main.tsx dist/main/main/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 electron dist/main/main/main.js\"",
    "build": "vite build && tsc -p tsconfig.main.json",
    "start": "electron dist/main/main/main.js",
    "package:win": "pnpm build && electron-builder --win nsis",
    "test:main": "pnpm build && node --test dist/main/main/application-launcher.test.js dist/main/main/git-checkpoint.test.js dist/main/main/update-policy.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.main.json"
  },
  "dependencies": {
    "@sots/agent-policy": "workspace:*",
    "@sots/browser-observer": "workspace:*",
    "@sots/desktop-contracts": "workspace:*",
    "@sots/document-intelligence": "workspace:*",
    "@sots/instrumentation-adapters": "workspace:*",
    "@sots/local-relay": "workspace:*",
    "@sots/project-intelligence": "workspace:*",
    "electron-updater": "^6.6.2",
    "lucide-react": "^1.18.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "7.9.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "43.2.0",
    "electron-builder": "^26.0.20",
    "typescript": "^5.0.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.tellann.desktop",
    "productName": "Tellann",
    "beforePack": "build/before-pack.cjs",
    "asar": true,
    "files": [
      "dist/**/*",
      "!dist/**/*.test.js",
      "package.json"
    ],
    "directories": {
      "output": "release/phase1"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Tellann-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
