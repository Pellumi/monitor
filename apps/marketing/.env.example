# Marketing App Environment Variables

# Primary canonical public URL for the marketing site (used for sitemap, robots.txt, and metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3020"

# Main dashboard Web App URL (used for "Sign in", "Start free", and CTA links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Documentation site URL (used for footer and navigation doc links)
NEXT_PUBLIC_DOCS_URL="http://localhost:3010"

# Download link for the Tellann Desktop Windows installer (used on /desktop page)
NEXT_PUBLIC_DESKTOP_WINDOWS_DOWNLOAD_URL="#download-unavailable"
